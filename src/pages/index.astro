---
// index.astro — the homepage. Since Nov 2026 (Aesop Analytics LLC closed), the site
// is Jonathan Doreau's personal research and writing site: hero → featured study →
// field studies → recent writing → free tools → about. Everything is derived from
// src/data/insights.ts, so a new article or study shows up here with no markup edit.
// URL preserved: "/".
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Reveal from "../components/Reveal.astro";
import { featured, sections } from "../data/insights.ts";
import { linkHref } from "../data/nav.ts";

const title = 'Aesop Analytics | Research and writing by Jonathan Doreau';
const description = "Field studies on the economy and on data, and practical writing on reporting trust, KPI definitions, dashboard design and data governance, by Jonathan Doreau.";
const ogDescription = "Field studies and practical writing on data, measurement and the economy. Every dataset has a moral.";

const studies = sections.filter((s) => s.pillar === "field-study").flatMap((s) => s.rows);
const writing = sections
  .filter((s) => s.pillar !== "field-study")
  .flatMap((s) => s.rows)
  .sort((a, b) => b.published.localeCompare(a.published))
  .slice(0, 6);
const fmt = (iso: string) =>
  new Date(iso + "T12:00:00Z").toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
---

<BaseLayout title={title} description={description} path="/" ogDescription={ogDescription}>
<div class="reface">

  <Hero eyebrow="Research &amp; writing · Jonathan Doreau">
    <h1>What the numbers <span class="em">actually</span> say.</h1>
    <Fragment slot="sub">Field studies on the economy and on data, and practical writing on reporting, KPIs and governance. Every study names its sources and says what the data can and can't support.</Fragment>
    <Fragment slot="cta">
      <a href="/publications/" class="btn">Read the research</a>
      <a href="/insights/" class="btn ghost">Browse the writing</a>
    </Fragment>
    <div slot="note" class="hero-note reveal" style="animation:rise .7s cubic-bezier(.2,.7,.2,1) .36s forwards">Aesop Analytics · Nashville, TN</div>
  </Hero>

  <!-- ── FEATURED STUDY ── -->
  <section class="feat band-paper">
    <div class="wrap">
      <div class="sec-label" style="display:inline-block">Latest study</div>
      <a href={linkHref(`/insights/${featured.slug}`)} class="feat-card">
        <img src={featured.image} alt={featured.imageAlt} width="560" height="560" loading="eager" />
        <div class="feat-body">
          <div class="feat-tag">{featured.tag}</div>
          <h2>{featured.title}</h2>
          <p>{featured.desc}</p>
          <span class="feat-go">{featured.read}</span>
        </div>
      </a>
    </div>
  </section>

  <!-- ── FIELD STUDIES ── -->
  <section class="studies band-paper2">
    <div class="wrap">
      <div class="row-head">
        <div>
          <div class="sec-label">Research</div>
          <h2>Field studies.</h2>
        </div>
        <a href="/publications/" class="row-more">All research &rarr;</a>
      </div>
      <div class="study-grid">
        {studies.map((r) => (
          <a href={linkHref(`/insights/${r.slug}`)} class="study-card">
            <div class="sc-meta">{fmt(r.published)} · {r.time}</div>
            <h3>{r.title}</h3>
            <p>{r.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── RECENT WRITING ── -->
  <section class="writing band-paper">
    <div class="wrap">
      <div class="row-head">
        <div>
          <div class="sec-label">Writing</div>
          <h2>Recent articles.</h2>
        </div>
        <a href="/insights/" class="row-more">All writing &rarr;</a>
      </div>
      <ol class="write-list">
        {writing.map((r) => (
          <li>
            <a href={linkHref(`/insights/${r.slug}`)}>
              <span class="wl-pill">{r.pill}</span>
              <span class="wl-title">{r.title}</span>
              <span class="wl-desc">{r.desc}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── TOOLS ── -->
  <section class="tools band-navy ae-host ae-mark" style="--ae-size:min(40vw,440px); --ae-left:-4%; --ae-bottom:-30%; --ae-opacity:.05;">
    <div class="wrap">
      <div class="sec-label">Free tools</div>
      <h2 class="tools-h">Score your own reporting.</h2>
      <p class="lede tools-lede">Two self-checks built on the method in the writing. They run in your browser, ask for no email, and send nothing anywhere.</p>
      <div class="tools-grid">
        <a href="/resources/health-check/" class="tool">
          <div class="t-tag">~10 min · scored 0&ndash;100</div>
          <h3>Reporting Trust Health Check</h3>
          <p>Eleven areas across five pillars, scored into one honest number, with the one fix that matters most named.</p>
        </a>
        <a href="/resources/dashboard-audit/" class="tool">
          <div class="t-tag">30 questions · one dashboard</div>
          <h3>Dashboard Audit</h3>
          <p>Score a single dashboard across six dimensions and leave with a prioritized list of what to fix.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── ABOUT ── -->
  <section class="author band-paper">
    <div class="wrap author-in">
      <img src="/assets/jonathan-doreau.jpg" alt="Jonathan Doreau" width="680" height="850" loading="lazy" />
      <div>
        <div class="sec-label">About</div>
        <h2>Jonathan Doreau</h2>
        <p>A data and analytics professional in Nashville with more than fifteen years in reporting, business intelligence and data governance, across finance, healthcare research and real estate. This is where he publishes what he learns.</p>
        <a href="/about/" class="row-more">More about Jonathan &rarr;</a>
      </div>
    </div>
  </section>

  <Reveal selector=".study-card,.write-list li,.tool" />
</div>

<style>
  .feat, .studies, .writing, .tools, .author { padding:84px 0; }
  .feat-card { display:grid; grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr); gap:40px; align-items:center; background:#fff; border:1px solid var(--line); border-top:3px solid var(--twine); border-radius:10px; padding:28px; margin-top:18px; transition:box-shadow .18s, transform .18s; }
  .feat-card:hover { transform:translateY(-3px); box-shadow:0 18px 44px -22px rgba(15,31,56,.28); }
  .feat-card img { width:100%; height:auto; border-radius:6px; display:block; }
  @media(max-width:760px){ .feat-card { grid-template-columns:1fr; gap:22px; padding:20px; } }
  .feat-tag, .t-tag { font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:.16em; color:var(--twine); margin-bottom:12px; }
  .feat-body h2 { color:var(--navy); margin-bottom:14px; }
  .feat-body p { font-size:16.5px; color:var(--slate); line-height:1.62; font-weight:300; margin-bottom:20px; }
  .feat-go, .row-more { font-size:14px; font-weight:600; color:var(--twine); }
  .row-more:hover { color:var(--sepia); }

  .row-head { display:flex; justify-content:space-between; align-items:flex-end; gap:20px; margin-bottom:32px; flex-wrap:wrap; }
  .row-head h2 { color:var(--navy); }
  .study-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
  @media(max-width:860px){ .study-grid { grid-template-columns:1fr; } }
  .study-card { display:flex; flex-direction:column; background:#fff; border:1px solid var(--line); border-radius:8px; padding:24px 22px; transition:border-color .18s, transform .18s; }
  .study-card:hover { border-color:var(--twine); transform:translateY(-3px); }
  .sc-meta { font-size:12px; color:var(--muted); margin-bottom:10px; }
  .study-card h3 { color:var(--navy); margin-bottom:10px; }
  .study-card p { font-size:14.5px; color:var(--slate); line-height:1.58; font-weight:300; }

  .write-list { list-style:none; margin:0; padding:0; border-top:2px solid var(--rule); }
  .write-list li { border-bottom:1px solid var(--line); }
  .write-list a { display:grid; grid-template-columns:150px 1fr; gap:4px 28px; padding:20px 0; }
  .write-list a:hover .wl-title { color:var(--twine); }
  .wl-pill { grid-row:span 2; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.14em; color:var(--twine); padding-top:5px; }
  .wl-title { font-family:"Newsreader",Georgia,serif; font-weight:600; font-size:21px; color:var(--navy); line-height:1.2; transition:color .18s; }
  .wl-desc { font-size:14.5px; color:var(--slate); line-height:1.55; font-weight:300; }
  @media(max-width:640px){ .write-list a { grid-template-columns:1fr; } .wl-pill { grid-row:auto; padding-top:0; } }

  .tools .sec-label { color:var(--twine); }
  .tools-h { color:#fff; margin-bottom:14px; }
  .tools-lede { color:#C4BDAE; max-width:60ch; margin-bottom:36px; }
  .tools-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:18px; }
  @media(max-width:700px){ .tools-grid { grid-template-columns:1fr; } }
  .tool { display:block; background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.1); border-top:3px solid var(--twine); border-radius:8px; padding:26px 24px; transition:background .18s, transform .18s; }
  .tool:hover { background:rgba(255,255,255,.07); transform:translateY(-3px); }
  .tool h3 { color:#fff; margin-bottom:10px; }
  .tool p { font-size:14.5px; color:#B8C2D0; line-height:1.6; font-weight:300; }

  .author-in { display:grid; grid-template-columns:200px 1fr; gap:40px; align-items:center; }
  .author-in img { width:100%; height:auto; border-radius:8px; display:block; }
  @media(max-width:640px){ .author-in { grid-template-columns:1fr; } .author-in img { max-width:200px; } }
  .author h2 { color:var(--navy); margin-bottom:12px; }
  .author p { font-size:17px; color:var(--slate); line-height:1.65; font-weight:300; max-width:62ch; margin-bottom:16px; }
</style>
</BaseLayout>
