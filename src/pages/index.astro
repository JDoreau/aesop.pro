---
// index.astro — the front page. Since Nov 2026 (Aesop Analytics LLC closed), the site
// is Jonathan Doreau's personal research and writing site. The page is set as a
// front page: the claim at poster scale, the latest study as the lead with its plate,
// the other studies as a box score, the recent writing as an index, the two tools on
// the ink band, the author. Everything is derived from src/data/insights.ts, so a new
// article or study shows up here with no markup edit. URL preserved: "/".
import BaseLayout from "../layouts/BaseLayout.astro";
import { featured, sections } from "../data/insights.ts";
import { linkHref, site } from "../data/nav.ts";

const title = 'Aesop Analytics | Research and writing by Jonathan Doreau';
const description = "Field studies on the economy and on data, and practical writing on reporting trust, KPI definitions, dashboard design and data governance, by Jonathan Doreau.";
const ogDescription = "Field studies and practical writing on data, measurement and the economy. Every dataset has a moral.";

const studies = sections.filter((s) => s.pillar === "field-study").flatMap((s) => s.rows);
const writing = sections
  .filter((s) => s.pillar !== "field-study")
  .flatMap((s) => s.rows)
  .sort((a, b) => b.published.localeCompare(a.published))
  .slice(0, 6);
const fmt = (iso: string) =>
  new Date(iso + "T12:00:00Z").toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
// A "·" in a data string is a separator: each part is set as its own fact.
const parts = (s: string) => s.split("·").map((x) => x.trim()).filter(Boolean);
const leadHref = linkHref(`/insights/${featured.slug}`);
// The first screen's box score: every field study's own headline figure, newest first.
const findings = [featured, ...studies].sort((a, b) => b.published.localeCompare(a.published));
---

<BaseLayout title={title} description={description} path="/" ogDescription={ogDescription} front={true}>

  <!-- ── The claim at poster scale, and what the numbers say: each study's finding as a box score ── -->
  <section class="front">
    <div class="container front__in">
      <h1>What the numbers actually say.</h1>
      <div class="front__deck">
        <p class="lead">Field studies on the economy and on data, and practical writing on reporting, KPIs and governance. Every study names its sources and says what the data can and can’t support.</p>
        <div class="actions">
          <a href="/publications/" class="btn btn--primary">Read the research</a>
          <a href="/insights/" class="btn btn--secondary">Browse the writing</a>
        </div>
      </div>
      <ul class="score front__figs" aria-label="Findings from the field studies">
        {findings.map((s) => (
          <li>
            <a class="front__fig" href={linkHref(`/insights/${s.slug}`)}>
              <span class="visually-hidden">{s.title}: </span>
              <span class="score__n">{s.figure}</span>
              <span class="score__l">{s.figureNote}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── The lead: the latest study, its plate across the full measure ── -->
  <section class="lead-story">
    <div class="container">
      <div class="lead-story__head">
        <div class="lead-story__text">
          <a href={leadHref} class="lead-story__link"><h2>{featured.title}</h2></a>
          <p class="lead">{featured.desc}</p>
          <ul class="meta">
            <li><time datetime={featured.published}>{fmt(featured.published)}</time></li>
            {parts(featured.tag).map((t) => (<li>{t}</li>))}
          </ul>
          <a href={leadHref} class="more">Read the study</a>
        </div>
        <figure class="plate lead-story__plate">
          <a href={leadHref} tabindex="-1" aria-hidden="true"><img src={featured.image} alt="" width="2160" height="2160" loading="eager" /></a>
          <figcaption>{featured.imageAlt}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ── Field studies: the other three, three across ── -->
  <section class="section section--flush-top">
    <div class="container">
      <div class="head">
        <h2>Field studies.</h2>
        <a href="/publications/" class="more">All research</a>
      </div>
      <div class="score studies3">
        {studies.map((r) => (
          <article>
            <a class="score__link" href={linkHref(`/insights/${r.slug}`)}><h3 class="score__t">{r.title}</h3></a>
            <p>{r.desc}</p>
            <ul class="meta">
              <li><time datetime={r.published}>{fmt(r.published)}</time></li>
              <li class="agate">{r.time}</li>
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Recent writing: an index ── -->
  <section class="section section--flush-top">
    <div class="container">
      <div class="head">
        <h2>Recent articles.</h2>
        <a href="/insights/" class="more">All writing</a>
      </div>
      <ol class="index">
        {writing.map((r) => (
          <li>
            <span class="index__kind">{r.pill}</span>
            <div class="index__main">
              <a class="index__link" href={linkHref(`/insights/${r.slug}`)}><h3 class="index__title">{r.title}</h3></a>
              <p class="index__desc">{r.desc}</p>
            </div>
            <span class="index__fig">{r.time}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── The tools, on the ink band ── -->
  <section class="band band--ink section tools">
    <div class="container">
      <div class="head">
        <h2>Score your own reporting.</h2>
        <p class="lead">Two self-checks built on the method in the writing. They run in your browser, ask for no email, and send nothing anywhere.</p>
      </div>
      <div class="pair">
        <div class="pair__item">
          <h3>Reporting Trust Health Check</h3>
          <p class="lead">Eleven areas across five pillars, scored into one honest number, with the one fix that matters most named.</p>
          <ul class="meta">
            <li>~10 min</li>
            <li>scored 0&ndash;100</li>
          </ul>
          <a href="/resources/health-check/" class="btn btn--primary">Take the Health Check</a>
        </div>
        <div class="pair__item">
          <h3>Dashboard Audit</h3>
          <p class="lead">Score a single dashboard across six dimensions and leave with a prioritized list of what to fix.</p>
          <ul class="meta">
            <li>30 questions</li>
            <li>one dashboard</li>
          </ul>
          <a href="/resources/dashboard-audit/" class="btn btn--secondary">Audit a dashboard</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── The author ── -->
  <section class="section author">
    <div class="container author__in">
      <figure class="plate author__plate">
        <img src="/assets/jonathan-doreau.jpg" alt="Jonathan Doreau" width="680" height="850" loading="lazy" />
        <figcaption>{site.author}, {site.location}</figcaption>
      </figure>
      <div class="author__text">
        <h2>Jonathan Doreau</h2>
        <p class="lead">A data and analytics professional in Nashville with more than fifteen years in reporting, business intelligence and data governance, across finance, healthcare research and real estate. This is where he publishes what he learns.</p>
        <a href="/about/" class="more">More about Jonathan</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── The front: a typographic poster. The head fills the measure, the standfirst and
        actions sit under it, and the findings close the screen as a box score ── */
  .front__in { display: flex; flex-direction: column; justify-content: flex-start; gap: var(--space-xl); min-height: calc(100svh - 9.75rem); padding-block: var(--space-xl) 0; }
  .front h1 { max-width: none; font-size: var(--text-poster); line-height: 0.92; letter-spacing: -0.035em; }
  .front__deck { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap-columns); row-gap: var(--space-lg); align-items: end; }
  .front__deck .lead { grid-column: 1 / span 7; max-width: 62ch; text-wrap: balance; }
  .front__deck .actions { grid-column: 9 / -1; justify-self: end; }
  .front__figs { grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: auto; }
  .front__figs > li { padding-block: var(--space-lg); }
  .front__fig { display: block; color: inherit; text-decoration: none; }
  .front__fig .score__n { font-size: clamp(2.5rem, 3.4vw + 1rem, 4.25rem); }
  .front__fig:hover .score__l { color: var(--color-ink); text-decoration: underline; text-decoration-thickness: 2px; text-decoration-color: var(--color-accent); text-underline-offset: 0.2em; }
  .front__fig:active .score__n { color: var(--color-accent); }
  @media (max-width: 60rem) {
    .front__in { min-height: 0; padding-block: var(--space-lg) 0; gap: var(--space-lg); }
    .front__deck .lead, .front__deck .actions { grid-column: 1 / -1; justify-self: start; }
    /* the box score two by two */
    .front__figs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .front__figs > li { padding: var(--space-md) var(--space-md) var(--space-md) 0; border-left: 0; border-top: 0; }
    .front__figs > li:nth-child(even) { padding-left: var(--space-md); padding-right: 0; border-left: var(--rule-hair) solid var(--color-rule); }
    .front__figs > li:nth-child(n + 3) { border-top: var(--rule-hair) solid var(--color-rule); }
  }
  @media (max-width: 40rem) {
    /* a phone poster: four short lines, set as large as the longest word allows */
    .front h1 { max-width: 4.6em; font-size: clamp(3.5rem, 19.5vw, 5.25rem); line-height: 0.9; }
    .front__deck .actions { flex-direction: column; align-items: stretch; justify-self: stretch; }
  }

  /* ── The other studies: title, line and date, three across (the shared box score without its figures) ── */
  .studies3 .score__link { margin-top: 0; }
  .studies3 p { margin-top: var(--space-sm); color: var(--color-ink-2); }
  .studies3 .meta { margin-top: var(--space-md); }

  /* ── The lead story ── */
  .lead-story { margin-top: var(--space-lg); padding-bottom: var(--section-gap); }
  .lead-story__head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap-columns); row-gap: var(--space-xl); align-items: center; padding-top: var(--space-2xl); border-top: var(--rule-double); }
  .lead-story__text { grid-column: 1 / span 7; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-lg); }
  .lead-story__link { color: inherit; text-decoration: none; }
  .lead-story h2 { max-width: 20ch; }
  .lead-story__link:hover h2 { text-decoration: underline; text-decoration-thickness: 3px; text-decoration-color: var(--color-accent); text-underline-offset: 0.12em; }
  .lead-story__text .lead { color: var(--color-ink-2); }
  .lead-story__plate { grid-column: 9 / -1; }
  .lead-story__plate a { display: block; }
  @media (max-width: 60rem) {
    .lead-story { padding-bottom: var(--section-gap-s); }
    .lead-story__head { padding-top: var(--space-xl); }
    .lead-story__text { grid-column: 1 / -1; }
    .lead-story__plate { grid-column: 1 / span 8; }
  }
  @media (max-width: 40rem) { .lead-story__plate { grid-column: 1 / -1; } }

  /* ── The author: the portrait as the paper prints it, the note beside it ── */
  .author__in { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap-columns); row-gap: var(--space-xl); align-items: center; }
  .author__plate { grid-column: 1 / span 4; }
  .author__plate img { aspect-ratio: 4 / 5; object-fit: cover; }
  .author__text { grid-column: 6 / -1; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-lg); }
  @media (max-width: 60rem) {
    .author__plate { grid-column: 1 / span 6; }
    .author__text { grid-column: 1 / -1; }
  }
  @media (max-width: 40rem) { .author__plate { grid-column: 1 / span 9; } }
</style>
