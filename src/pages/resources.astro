---
// resources.astro — the free-tools hub, refaced into the product-first Honest
// Expert voice using the shared section components + sections.css. The tools are
// framed as the free on-ramp to the governed system (Aesop Manteia): each one
// measures a piece of the trust gap the product then closes and keeps closed.
// URL preserved: "/resources". The Health Check (Krisis/TRUST Index scorer) is
// the canonical instrument — this page hands off to it, never forks it.
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import PromiseBand from "../components/PromiseBand.astro";
import CtaBand from "../components/CtaBand.astro";
import Reveal from "../components/Reveal.astro";

const title = 'Free Resources: Reporting Trust Tools | Aesop Analytics';
const description = 'Free tools to measure where your reporting trust is breaking down — the Reporting Trust Health Check, a dashboard audit, a fully worked sample assessment, and a letter for your team. No email walls.';
const ogDescription = "Free, deterministic tools for reporting trust: a scored Health Check, a dashboard audit, a worked sample assessment, and more. No email required.";
---

<BaseLayout title={title} description={description} path="/resources" ogDescription={ogDescription}>
<div class="reface">

  <!-- ── HERO ── -->
  <Hero eyebrow="Free resources · No email required">
    <h1>See where your reporting trust <span class="em">breaks down</span> — for free.</h1>
    <Fragment slot="sub">These four tools are the free on-ramp to the platform. Each one runs the same method that powers Aesop Manteia, our data-trust software — so each measures a piece of the trust gap the platform then closes and keeps closed. Everything runs in your browser, nothing is walled behind an email, and the scoring is deterministic: the same answers always give the same result.</Fragment>
    <Fragment slot="cta">
      <a href="/resources/health-check/?utm_source=site&utm_medium=internal&utm_campaign=resources-hero-healthcheck" class="btn">Take the Health Check</a>
      <a href="#toolkit" class="btn ghost">See all four tools</a>
    </Fragment>
    <div slot="note" class="hero-note reveal" style="animation:rise .7s cubic-bezier(.2,.7,.2,1) .36s forwards">Deterministic · runs in your browser · no email required</div>
  </Hero>

  <!-- ── PROMISE BAND ── -->
  <PromiseBand />

  <!-- ── THE TOOLKIT ── -->
  <section class="toolkit band-paper" id="toolkit">
    <div class="wrap">
      <div class="sec-head">
        <div class="sec-label" style="display:inline-block">The toolkit</div>
        <h2>Four free tools, one honest method.</h2>
        <p>Start with the Health Check for the whole picture, or reach for the tool that matches the question you have today. None of them ask for anything in return — they exist to show you the trust gap plainly, the same way the platform does.</p>
      </div>
      <div class="tool-grid">
        <a href="/resources/health-check/?utm_source=site&utm_medium=internal&utm_campaign=resources-card-healthcheck" class="tool-card hl reveal">
          <div class="tc-tag">Scored self-assessment · ~10 min</div>
          <h3>Reporting Trust Health Check</h3>
          <p>The full instrument: eleven areas across the five TRUST pillars, scored into one honest 0&ndash;100 Trust Initiate Score — band-gated so a strong area can't hide a weak one. You leave with your binding constraint named and a plain-English report you can print and bring to a call.</p>
          <span class="tc-go">Take the Health Check &rarr;</span>
        </a>
        <a href="/resources/dashboard-audit/" class="tool-card reveal">
          <div class="tc-tag">Interactive audit · 30 questions</div>
          <h3>Dashboard Audit</h3>
          <p>Score one dashboard across six dimensions — purpose, definitions, data trust, design, governance, and operational health — and walk away with a prioritized list of exactly what to fix, with a fix hint behind every weak answer.</p>
          <span class="tc-go">Run the audit &rarr;</span>
        </a>
        <a href="/resources/sample-assessment/" class="tool-card reveal">
          <div class="tc-tag">Worked example</div>
          <h3>Sample Assessment</h3>
          <p>See exactly what a Reporting Clarity Assessment delivers — a complete, anonymized engagement from the triggering conflict through the findings, the scored estate, the Trust Initiate Score, and a self-executable 30/60/90-day roadmap.</p>
          <span class="tc-go">Read the sample &rarr;</span>
        </a>
        <a href="/resources/trust-letter/" class="tool-card reveal">
          <div class="tc-tag">For your team</div>
          <h3>The Reporting Trust Letter</h3>
          <p>Practical notes on reporting trust, KPI clarity, dashboard design, and lightweight governance — written for the people who have to defend the figures in the room. Roughly twice a month, no drip sequence, unsubscribe in one click.</p>
          <span class="tc-go">Get the letter &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── THE HEALTH CHECK (the anchor instrument) ── -->
  <section class="anchor band-navy ae-host ae-mark" id="health-check" style="--ae-size:min(40vw,460px); --ae-left:-4%; --ae-bottom:-24%; --ae-opacity:.05;">
    <div class="wrap">
      <div class="sec-label">Start here</div>
      <h2 class="anchor-h">The Reporting Trust Health Check.</h2>
      <p class="lede anchor-lede">One canonical instrument, scored the way the platform scores your estate: it reads the five TRUST pillars, gates the number downward so a strong half can't mask a weak one, and hands you a genuine diagnosis rather than a vanity score. It's the fastest way to see what Aesop Manteia would find. About two minutes for a fast pass, ten for a considered one.</p>
      <div class="anchor-card">
        <div class="anchor-main">
          <div class="anchor-kicker">Reporting Trust Health Check</div>
          <div class="anchor-title">Your Trust Initiate Score — 0 to 100, with a real diagnosis.</div>
          <p class="anchor-body">Eleven areas, three signal questions each, a band-gated score, an area-by-area read, and a "start here" list you can print and bring to a diagnostic call. Computed deterministically, right in your browser — nothing is sent anywhere unless you choose to email yourself the report.</p>
          <a href="/resources/health-check/?utm_source=site&utm_medium=internal&utm_campaign=resources-featured-healthcheck" class="btn">Take the Health Check &rarr;</a>
        </div>
        <ul class="anchor-list">
          <li>A 0&ndash;100 Trust Initiate Score, band-gated so a high score means a genuinely trustworthy operation</li>
          <li>Your binding constraint — the one fix that moves the needle most</li>
          <li>An area-by-area read with a prioritized place to start</li>
          <li>A printable, branded report you can keep or share</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ── HOW TO PUT IT TO WORK ── -->
  <section class="how-use band-paper2">
    <div class="wrap">
      <div class="sec-label" style="display:inline-block">How to put it to work</div>
      <h2 class="how-h">Three ways to turn a score into a conversation.</h2>
      <div class="flow-grid steps3">
        <div class="use-step">
          <div class="us-n">01</div>
          <h3>Score it yourself</h3>
          <p>Work through each area with the signal questions and rate it honestly. Anything below five is where trust is most at risk; below three is likely already costing you decisions.</p>
        </div>
        <div class="use-step">
          <div class="us-n">02</div>
          <h3>Score it as a team</h3>
          <p>Have your analytics lead, your finance lead, and a department head each score the same areas independently. The gaps between their scores are often as revealing as the scores themselves.</p>
        </div>
        <div class="use-step">
          <div class="us-n">03</div>
          <h3>Bring it to a diagnostic</h3>
          <p>Bring your scores to a free 30-minute diagnostic. It makes the conversation far more productive — we can focus on the lowest-scoring areas and work out honestly whether a structured assessment would help.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── FINAL CTA ── -->
  <CtaBand eyebrow="Want help reading your score?">
    <h2>Bring your results to a real conversation.</h2>
    <Fragment slot="sub">A free 30-minute diagnostic — bring your Health Check scores and we'll identify the highest-impact areas together. If a structured assessment isn't the right next step for where you are, we'll tell you plainly.</Fragment>
    <Fragment slot="cta">
      <a href="/diagnostic/?utm_source=site&utm_medium=internal&utm_campaign=resources-closing-diagnostic" class="btn on-light">Book a diagnostic</a>
      <a href="/resources/health-check/?utm_source=site&utm_medium=internal&utm_campaign=resources-closing-healthcheck" class="btn ghost">Take the Health Check first</a>
    </Fragment>
  </CtaBand>

  <Reveal selector=".tool-card,.use-step,.anchor-list li" />
</div>

<style>
  /* Page-local: the tool directory + the anchor instrument card + how-to steps.
     Assembled on the shared bands/type from sections.css. */
  .toolkit { padding:88px 0; }
  .tool-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:18px; }
  @media(max-width:640px){ .tool-grid { grid-template-columns:1fr; } }
  .tool-card { display:flex; flex-direction:column; background:#fff; border:1px solid var(--line); border-radius:8px; padding:28px 26px; transition:border-color .18s, transform .18s, box-shadow .18s; }
  .tool-card.hl { border-top:3px solid var(--twine); }
  .tool-card:hover { border-color:var(--twine); transform:translateY(-3px); box-shadow:0 16px 40px -20px rgba(15,31,56,.22); }
  .tc-tag { font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:.16em; color:var(--twine); margin-bottom:12px; }
  .tool-card h3 { margin-bottom:10px; }
  .tool-card p { font-size:14.5px; color:var(--slate); line-height:1.6; font-weight:300; margin-bottom:18px; flex:1; }
  .tc-go { font-size:13.5px; font-weight:600; color:var(--twine); }

  .anchor { padding:88px 0; }
  .anchor-h { color:#fff; margin-bottom:16px; max-width:22ch; }
  .anchor-lede { color:#C4BDAE; max-width:64ch; margin-bottom:40px; }
  .anchor-card { display:grid; grid-template-columns:1.25fr .9fr; gap:36px; align-items:center; background:rgba(255,255,255,.035); border:1px solid rgba(255,255,255,.1); border-top:3px solid var(--twine); border-radius:10px; padding:32px 34px; }
  @media(max-width:760px){ .anchor-card { grid-template-columns:1fr; gap:26px; padding:28px 24px; } }
  .anchor-kicker { font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:.16em; color:var(--twine); margin-bottom:12px; }
  .anchor-title { font-family:"Newsreader",Georgia,serif; font-weight:600; font-size:clamp(21px,2.5vw,28px); color:#fff; line-height:1.16; letter-spacing:-.01em; margin-bottom:14px; }
  .anchor-body { font-size:14.5px; color:#B8C2D0; line-height:1.62; font-weight:300; margin-bottom:24px; max-width:56ch; }
  .anchor-list { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px; }
  .anchor-list li { position:relative; padding-left:26px; font-size:13.5px; color:#C4BDAE; line-height:1.5; font-weight:300; }
  .anchor-list li::before { content:"✓"; position:absolute; left:0; top:1px; color:var(--twine); font-weight:700; }

  .how-use { padding:80px 0; }
  .how-h { margin-bottom:40px; max-width:26ch; }
  .flow-grid.steps3 { grid-template-columns:repeat(3,1fr); }
  @media(max-width:760px){ .flow-grid.steps3 { grid-template-columns:1fr; } }
  .use-step { background:#fff; border:1px solid var(--line); border-radius:8px; padding:24px 22px; }
  .us-n { font-family:"Newsreader",Georgia,serif; font-weight:600; font-size:34px; color:var(--twine); opacity:.55; line-height:1; margin-bottom:10px; }
  .use-step h3 { margin-bottom:9px; }
  .use-step p { font-size:14px; color:var(--slate); line-height:1.6; font-weight:300; }
</style>

</BaseLayout>
</content>
</invoke>
