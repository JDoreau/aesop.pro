---
// resources.astro — the free-tools hub. Since Nov 2026 the site is a personal
// research site, so the tools stand on their own: no funnel, no email, nothing
// leaves the browser. The Health Check (TRUST Index scorer) is the canonical
// instrument — this page hands off to it, never forks it. URL preserved.
import BaseLayout from "../layouts/BaseLayout.astro";

const title = 'Free Tools: Reporting Trust Self-Checks | Aesop Analytics';
const description = 'Two free self-checks for reporting trust: the Reporting Trust Health Check and a Dashboard Audit. They run in your browser, ask for no email, and send nothing anywhere.';
const ogDescription = "Free, deterministic self-checks for reporting trust. No email, nothing leaves your browser.";
---

<BaseLayout title={title} description={description} path="/resources" ogDescription={ogDescription}>

  <header class="page-head">
    <div class="container">
      <h1>Score your own reporting.</h1>
      <p class="lead">Two self-checks built on the method in the writing on this site. Everything runs in your browser, nothing is behind an email, and the scoring is deterministic: the same answers always give the same result.</p>
      <div class="actions">
        <a href="/resources/health-check/" class="btn btn--primary">Take the Health Check</a>
        <a href="/resources/dashboard-audit/" class="btn btn--secondary">Audit a dashboard</a>
      </div>
      <ul class="meta">
        <li>Free tools</li>
        <li>Deterministic</li>
        <li>Runs in your browser</li>
        <li>No email required</li>
      </ul>
    </div>
  </header>

  <section class="toolkit" id="toolkit">
    <div class="container">
      <div class="pair">
        <div class="pair__item">
          <h2>Reporting Trust Health Check</h2>
          <p class="lead">Eleven areas across the five TRUST pillars, scored into one honest 0&ndash;100 Trust Initiate Score — band-gated so a strong area can’t hide a weak one. You leave with your binding constraint named and a plain-English report you can print.</p>
          <ul class="meta">
            <li>Scored self-assessment</li>
            <li>~10 min</li>
          </ul>
          <a href="/resources/health-check/" class="more" aria-label="Take the Reporting Trust Health Check">Take the Health Check</a>
        </div>
        <div class="pair__item">
          <h2>Dashboard Audit</h2>
          <p class="lead">Score one dashboard across six dimensions — purpose, definitions, data trust, design, governance and operational health — and walk away with a prioritized list of what to fix, with a hint behind every weak answer.</p>
          <ul class="meta">
            <li>Interactive audit</li>
            <li>30 questions</li>
          </ul>
          <a href="/resources/dashboard-audit/" class="more">Run the audit</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section band how-use">
    <div class="container">
      <div class="head">
        <h2>Three ways to turn a score into a conversation.</h2>
      </div>
      <ol class="steps">
        <li>
          <h3>Score it yourself</h3>
          <p>Work through each area with the signal questions and rate it honestly. Anything below five is where trust is most at risk; below three is likely already costing you decisions.</p>
        </li>
        <li>
          <h3>Score it as a team</h3>
          <p>Have your analytics lead, your finance lead and a department head each score the same areas independently. The gaps between their scores are often as revealing as the scores themselves.</p>
        </li>
        <li>
          <h3>Start with the lowest</h3>
          <p>Take the single lowest-scoring area and read the matching article in <a href="/insights/">Writing</a>. One owned, agreed metric does more than a redesign of everything.</p>
        </li>
      </ol>
    </div>
  </section>

</BaseLayout>

<style>
  .toolkit { padding-bottom: var(--section-gap-s); }
  .how-use .head h2 { max-width: 22ch; }
</style>
