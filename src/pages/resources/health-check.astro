---
// /resources/health-check - the Reporting Trust Health Check.
// Rebuilt 2026-06-15 as a focused, full-screen app powered by the TRUST Index.
// The page itself is a short, indexable intro; "Launch" opens the
// full-screen experience. All scoring/selection is the proven engine in
// src/lib/trust-index*.js; the UI controller is src/lib/health-check-app.js.
import BaseLayout from "../../layouts/BaseLayout.astro";
import OwlMark from "../../components/OwlMark.astro";

---
<BaseLayout
  title="Reporting Trust Health Check - Aesop Analytics"
  description="Score your reporting environment across the five TRUST pillars and get a personalized Trust Initiate Score (0-100) with a prioritized, plain-English report. Free - no email required."
  ogTitle="Reporting Trust Health Check - Aesop Analytics"
  ogDescription="Get your Trust Initiate Score (0-100) and a personalized report across 11 diagnostic areas. Free, deterministic, no email required."
  path="/resources/health-check"
>
<header class="page-head intro">
  <div class="container intro-in">
    <div class="intro-copy">
      <h1>The Reporting Trust<br>Health Check.</h1>
      <p class="lead lede">A fast read on your AI-readiness foundation — because it all comes down to one question: can your data be trusted? Score your organization across the five <strong>TRUST</strong> pillars and get a personalized <strong>Trust Initiate Score</strong> from 0 to 100, with a plain-English report on exactly where trust is breaking down and what to fix first. It’s a genuine diagnosis, computed deterministically in your browser.</p>
      <div class="actions">
        <button type="button" class="btn btn--primary" id="hc-launch">Launch the Health Check</button>
      </div>
      <ul class="meta intro-meta">
        <li>Free resource</li>
        <li>No email required</li>
        <li class="im">11 areas</li>
        <li class="im">5 TRUST pillars</li>
        <li class="im">~10 minutes</li>
        <li class="im">Runs in your browser</li>
      </ul>
      <p class="fineprint">Your answers are scored locally in your browser and aren’t sent anywhere. The Trust Initiate Score is computed deterministically — the same inputs always give the same score. It computes, it doesn’t guess.</p>
    </div>
    <aside class="intro-side">
      <h2 class="side-label">What you get</h2>
      <ul class="side-list">
        <li><strong>Your Trust Initiate Score</strong> — one honest 0&ndash;100 number, gated so a strong area can’t mask a weak one.</li>
        <li><strong>Five pillar scores</strong> — Triage, Reconcile, Unify, Standardize, Transition.</li>
        <li><strong>Your binding constraint</strong> — the one fix that moves the needle most.</li>
        <li><strong>A tailored report</strong> — findings, patterns, and where to start, specific to your profile.</li>
      </ul>
      <p class="side-note">A free self-check, built on the method described in the writing on this site. Nothing you enter leaves your browser.</p>
    </aside>
  </div>
</header>

<section class="below">
  <div class="container below-in">
    <h2>A quick self-diagnosis, five pillars deep.</h2>
    <p class="lead below-lede"><strong class="sec-label">How it works.</strong> The same five pillars the method reads on a real estate — asked here as a fast self-check you can run before anyone else is involved.</p>
    <div class="trust-grid">
      <div class="tg"><span class="tg-l">T</span><div><h3>Triage</h3><p>What reporting you have, and whether it earns its keep.</p></div></div>
      <div class="tg"><span class="tg-l">R</span><div><h3>Reconcile</h3><p>Whether the numbers agree and are believed.</p></div></div>
      <div class="tg"><span class="tg-l">U</span><div><h3>Unify</h3><p>Who owns each number and which system is authoritative.</p></div></div>
      <div class="tg"><span class="tg-l">S</span><div><h3>Standardize</h3><p>Whether a process keeps reporting trustworthy as it changes.</p></div></div>
      <div class="tg"><span class="tg-l">T</span><div><h3>Transition</h3><p>Whether reporting runs as a sustainable operating rhythm.</p></div></div>
    </div>
    <div class="actions">
      <button type="button" class="btn btn--secondary" onclick="document.getElementById('hc-launch').click()">Launch the Health Check</button>
    </div>
  </div>
</section>

<!-- Print-only branded header/footer (hidden on screen; shown only when printing the report) -->
<div class="hc-prt-head" aria-hidden="true">
  <div class="hc-prt-brand"><OwlMark size={26} /><span class="hc-prt-wm">aesop</span><span class="hc-prt-an">Analytics</span></div>
  <div class="hc-prt-kicker">Reporting Trust Health Check</div>
</div>
<div class="hc-prt-rule" aria-hidden="true"></div>
<div class="hc-prt-meta" aria-hidden="true">Self-assessment. Generated <span id="hc-prt-date"></span>.</div>

<!-- Full-screen app (filled + driven by health-check-app.js) -->
<div id="hc-app" class="hc-app" hidden></div>

<div class="hc-prt-foot" aria-hidden="true">
  <span>Aesop Analytics. Research and writing on data, measurement and the economy. Nashville, TN.</span>
  <span>&copy; <span id="hc-prt-year"></span>. Generated from the Reporting Trust Health Check at aesopanalytics.com/resources/health-check</span>
</div>
</BaseLayout>

<style>
  /* ── Intro: the page head, with what the report holds set beside it as a ruled list.
     (The full-screen app, the report and the print engine are is:global, below.) ── */
  .intro-in { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap-columns); row-gap: var(--space-xl); align-items: start; }
  .intro-copy { grid-column: 1 / span 8; min-width: 0; }
  .intro-side { grid-column: 9 / -1; min-width: 0; border-top: var(--rule-double); padding-top: var(--space-md); }
  .page-head h1 { max-width: none; }
  .fineprint { margin-top: var(--space-lg); max-width: 60ch; font-size: var(--text-sm); line-height: 1.5; color: var(--color-muted); }
  .side-label { max-width: none; font-size: var(--text-lg); line-height: 1.2; letter-spacing: -0.01em; }
  .side-list { margin: var(--space-md) 0 0; padding: 0; list-style: none; border-bottom: var(--rule-hair) solid var(--color-rule); }
  .side-list li { padding-block: var(--space-sm); border-top: var(--rule-hair) solid var(--color-rule); font-size: var(--text-md); line-height: 1.5; color: var(--color-ink-2); }
  .side-list strong { color: var(--color-ink); }
  .side-note { margin-top: var(--space-md); font-size: var(--text-sm); line-height: 1.5; color: var(--color-muted); }
  @media (max-width: 60rem) {
    .intro-copy, .intro-side { grid-column: 1 / -1; }
  }

  /* ── The five pillars: five ruled columns under a double rule ── */
  .below { padding-bottom: 0; }
  .below-in > h2 { padding-top: var(--space-xl); border-top: var(--rule-hair) solid var(--color-rule-2); max-width: none; font-size: var(--text-head); line-height: 1.08; }
  .below-lede { margin-top: var(--space-md); max-width: 62ch; color: var(--color-ink-2); }
  .sec-label { color: var(--color-ink); }
  .trust-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); margin-top: var(--space-xl); border-top: var(--rule-double); }
  .tg { display: flex; flex-direction: column; gap: var(--space-md); min-width: 0; padding: var(--space-lg) var(--space-lg) 0; border-left: var(--rule-hair) solid var(--color-rule); }
  .tg:first-child { padding-left: 0; border-left: 0; }
  .tg:last-child { padding-right: 0; }
  .tg-l { font-family: var(--font-display); font-weight: 700; font-size: var(--text-numeral); line-height: 0.95; letter-spacing: var(--tracking-display); color: var(--color-ink); }
  .tg h3 { font-size: var(--text-lg); line-height: 1.2; letter-spacing: -0.01em; }
  .tg p { margin-top: var(--space-xs); font-size: var(--text-md); line-height: 1.5; color: var(--color-ink-2); }
  .below .actions { margin-top: var(--space-xl); }
  @media (max-width: 60rem) {
    .trust-grid { grid-template-columns: minmax(0, 1fr); }
    .tg, .tg:first-child, .tg:last-child { flex-direction: row; align-items: baseline; gap: var(--space-md); padding: var(--space-md) 0; border-left: 0; border-top: var(--rule-hair) solid var(--color-rule); }
    .tg:first-child { border-top: 0; }
    .tg-l { flex: 0 0 var(--space-xl); font-size: var(--text-3xl); line-height: 1; }
  }
</style>

<style is:global>
  /* ── Full-screen app: a paper screen above the page, with one ink band at its top ── */
  body.hc-open { overflow-y: hidden; }
  .hc-app { position: fixed; inset: 0; z-index: var(--z-modal); background: var(--color-paper); color: var(--color-ink); overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; }
  .hc-app[hidden] { display: none; }

  .hc-top { position: sticky; top: 0; z-index: var(--z-raised); display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs) var(--space-lg); padding: var(--space-sm) var(--gutter); background: var(--color-ink); color: var(--color-on-ink); }
  .hc-brand { display: flex; flex: 1 1 0; flex-wrap: wrap; align-items: baseline; gap: 0 var(--space-sm); min-width: 0; }
  .hc-wm { font-family: var(--font-wordmark); font-size: var(--text-xl); line-height: 1.2; }
  .hc-wm-an { font-family: var(--font-display); font-weight: 700; font-size: var(--text-md); line-height: 1.2; }
  .hc-steps { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--space-md); font-size: var(--text-sm); line-height: 1.4; }
  .hc-dot { padding-block: var(--space-2xs); border-bottom: 2px solid transparent; font-weight: 500; color: var(--color-on-ink); }
  .hc-dot.done { color: var(--color-on-ink-2); }
  .hc-dot.on { font-weight: 700; border-bottom-color: var(--color-accent-on-ink); }
  .hc-x { min-height: 44px; padding: 0 var(--space-md); border: var(--rule-hair) solid var(--color-on-ink-2); border-radius: 0; background: none; font-family: var(--font-body); font-weight: 500; font-size: var(--text-md); line-height: 1; color: var(--color-on-ink); cursor: pointer; transition: background-color var(--dur-short) var(--ease-out), transform var(--dur-micro) var(--ease-out); }
  .hc-x:hover { background: var(--color-ink-2); }
  .hc-x:active { transform: translateY(1px); }
  .hc-x:focus-visible { outline: 2px solid var(--color-focus-on-ink); outline-offset: 2px; }
  @media (max-width: 60rem) {
    .hc-steps { order: 3; flex-basis: 100%; }
  }
  @media (max-width: 40rem) {
    .hc-dot:not(.on) { display: none; }
  }

  .hc-stage, .hc-report { width: 100%; max-width: var(--container); margin-inline: auto; padding: var(--space-xl) var(--gutter) var(--space-3xl); }
  .hc-stephead { padding-bottom: var(--space-xl); }
  .hc-step-title { max-width: 24ch; font-size: var(--text-head); line-height: 1.08; }
  .hc-step-kicker { margin-top: var(--space-xs); font-size: var(--text-sm); font-weight: 500; line-height: 1.4; color: var(--color-muted); }
  .hc-step-blurb { margin-top: var(--space-md); max-width: 46rem; font-size: var(--text-lead); line-height: 1.45; color: var(--color-ink-2); }

  /* an area: a block ruled on top; what it asks on the left, the rating on the right */
  .hc-area { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap-columns); row-gap: var(--space-lg); align-items: start; padding-block: var(--space-lg) var(--space-xl); border-top: var(--rule-hair) solid var(--color-rule-2); }
  .hc-area-text { grid-column: 1 / span 7; min-width: 0; max-width: 46rem; }
  .hc-area-name { max-width: none; font-size: var(--text-xl); line-height: 1.15; }
  .hc-area-desc { margin-top: var(--space-xs); font-size: var(--text-body); line-height: 1.5; color: var(--color-ink-2); }
  .hc-qs { display: flex; flex-direction: column; gap: var(--space-2xs); margin: var(--space-md) 0 0; padding: 0 0 0 var(--space-lg); list-style: square; }
  .hc-qs li { font-size: var(--text-md); line-height: 1.5; color: var(--color-ink-2); }
  .hc-qs li::marker { color: var(--color-muted); }
  .hc-rate { grid-column: 8 / -1; min-width: 0; }
  .hc-rate-top { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-md); font-size: var(--text-md); font-weight: 500; line-height: 1.4; color: var(--color-ink); }
  .hc-val { flex: none; font-family: var(--font-outlier); font-weight: 500; font-size: var(--text-lg); font-variant-numeric: tabular-nums; color: var(--color-ink); }
  .hc-slider { display: block; width: 100%; min-height: 44px; margin: var(--space-2xs) 0 0; accent-color: var(--color-ink); cursor: pointer; }
  .hc-scale { display: flex; justify-content: space-between; gap: var(--space-md); font-size: var(--text-sm); line-height: 1.4; color: var(--color-muted); }
  .hc-scale > :last-child { text-align: right; }
  @media (max-width: 60rem) {
    .hc-area-text, .hc-rate { grid-column: 1 / -1; }
  }

  .hc-nav { display: flex; flex-wrap: wrap; gap: var(--space-sm); padding-top: var(--space-lg); border-top: var(--rule-double); }
  .hc-foot { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-lg); }

  /* ── Report ── */
  .hc-head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap-columns); row-gap: var(--space-lg); align-items: start; padding-bottom: var(--space-xl); }
  .hc-scorebox { grid-column: 1 / span 4; display: flex; flex-wrap: wrap; align-items: flex-end; gap: var(--space-sm) var(--space-md); min-width: 0; }
  .hc-index { font-family: var(--font-display); font-weight: 700; font-size: var(--text-poster); line-height: 0.8; letter-spacing: var(--tracking-display); font-variant-numeric: lining-nums; color: var(--color-ink); }
  .hc-score-side { display: flex; flex-direction: column; gap: var(--space-sm); min-width: 0; }
  .hc-index-max { font-family: var(--font-outlier); font-weight: 500; font-size: var(--text-lg); line-height: 1.2; font-variant-numeric: tabular-nums; color: var(--color-muted); }
  .hc-band-pill { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3xs); }
  .hc-band-pill::before { content: ""; order: -1; width: var(--space-xl); margin-bottom: var(--space-2xs); border-top: 3px solid var(--color-rule-2); }
  .hc-band-pill.bp-critical::before { border-top-color: var(--status-low); }
  .hc-band-pill.bp-concern::before { border-top-color: var(--status-mid); }
  .hc-band-pill.bp-stable::before { border-top-color: var(--color-rule-2); }
  .hc-band-pill.bp-strong::before { border-top-color: var(--status-high); }
  .hc-band-label { font-size: var(--text-sm); font-weight: 500; line-height: 1.4; color: var(--color-muted); }
  .hc-band-word { font-family: var(--font-display); font-weight: 700; font-size: var(--text-xl); line-height: 1.1; letter-spacing: var(--tracking-display); color: var(--color-ink); }
  .hc-head-text { grid-column: 5 / -1; min-width: 0; max-width: 46rem; }
  .hc-head-title { max-width: none; font-size: var(--text-head); line-height: 1.08; }
  .hc-head-body { margin-top: var(--space-md); font-size: var(--text-body); line-height: 1.55; color: var(--color-ink-2); }
  .hc-gate-note { margin-top: var(--space-lg); padding: var(--space-sm) var(--space-md); background: var(--color-paper-2); border-block: var(--rule-hair) solid var(--color-rule); font-size: var(--text-md); line-height: 1.5; color: var(--color-ink); }

  .hc-bars { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: var(--rule-double); }
  .hc-half { min-width: 0; padding: var(--space-lg) var(--gap-columns) var(--space-xl) 0; }
  .hc-half + .hc-half { padding-right: 0; padding-left: var(--gap-columns); border-left: var(--rule-hair) solid var(--color-rule); }
  .hc-half-label { max-width: none; margin-bottom: var(--space-md); font-size: var(--text-lg); line-height: 1.2; letter-spacing: -0.01em; }
  .hc-bar-row { display: grid; grid-template-columns: 7rem minmax(0, 1fr) 2rem; column-gap: var(--space-md); align-items: center; padding-block: var(--space-xs); border-top: var(--rule-hair) solid var(--color-rule); }
  .hc-bar-label { font-size: var(--text-md); font-weight: 500; line-height: 1.4; color: var(--color-ink); }
  .hc-bar-track { height: 12px; background: var(--status-track); overflow: hidden; }
  .hc-bar-fill { height: 100%; background: var(--status-mid); }
  .hc-bar-fill.b-low { background: var(--status-low); }
  .hc-bar-fill.b-mid { background: var(--status-mid); }
  .hc-bar-fill.b-high { background: var(--status-high); }
  .hc-bar-score { font-family: var(--font-outlier); font-weight: 500; font-size: var(--text-sm); font-variant-numeric: tabular-nums; text-align: right; color: var(--color-ink); }

  /* a report section: its head in the left columns, its findings in the right */
  .hc-rsec { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap-columns); row-gap: var(--space-md); align-items: start; padding-block: var(--space-lg) var(--space-xl); border-top: var(--rule-hair) solid var(--color-rule-2); }
  .hc-sec-label { grid-column: 1 / span 4; max-width: 18ch; font-size: var(--text-xl); line-height: 1.15; }
  .hc-rsec-body { grid-column: 5 / -1; display: flex; flex-direction: column; gap: var(--space-lg); min-width: 0; }
  .hc-card { position: relative; min-width: 0; padding-top: var(--space-md); border-top: var(--rule-hair) solid var(--color-rule); }
  .hc-card[class*="sev-"]::before { content: ""; position: absolute; top: calc(-1 * var(--rule-hair)); left: 0; width: var(--space-xl); border-top: 3px solid var(--color-ink-2); }
  .hc-card.sev-critical::before { border-top-color: var(--status-low); }
  .hc-card.sev-warning::before { border-top-color: var(--status-mid); }
  .hc-card.sev-insight::before { border-top-color: var(--color-ink-2); }
  .hc-card.sev-positive::before { border-top-color: var(--status-high); }
  .hc-card-title { max-width: 46rem; font-size: var(--text-lg); line-height: 1.2; letter-spacing: -0.01em; }
  .hc-card-body { margin-top: var(--space-xs); max-width: 46rem; font-size: var(--text-md); line-height: 1.55; color: var(--color-ink-2); }
  .hc-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-lg) var(--gap-columns); }

  .hc-areas { border-top: var(--rule-hair) solid var(--color-rule); }
  .hc-area-row { display: grid; grid-template-columns: 13rem 3.5rem minmax(0, 1fr); column-gap: var(--space-md); row-gap: var(--space-2xs); align-items: baseline; padding-block: var(--space-sm); border-bottom: var(--rule-hair) solid var(--color-rule); }
  .hc-area-rowname { font-size: var(--text-md); font-weight: 700; line-height: 1.4; color: var(--color-ink); }
  .hc-area-chip { justify-self: start; padding-top: var(--space-3xs); border-top: 3px solid var(--status-mid); font-family: var(--font-outlier); font-weight: 500; font-size: var(--text-sm); line-height: 1.4; font-variant-numeric: tabular-nums; color: var(--color-ink); }
  .hc-area-chip.c-low { border-top-color: var(--status-low); }
  .hc-area-chip.c-mid { border-top-color: var(--status-mid); }
  .hc-area-chip.c-high { border-top-color: var(--status-high); }
  .hc-area-rowtext { font-size: var(--text-md); line-height: 1.5; color: var(--color-ink-2); }

  .hc-cta { margin-top: var(--space-lg); padding: var(--space-lg); background: var(--color-paper-2); border-block: var(--rule-hair) solid var(--color-rule); }
  .hc-cta-title { max-width: none; font-size: var(--text-xl); line-height: 1.15; }
  .hc-cta-body { margin-top: var(--space-xs); max-width: 60ch; font-size: var(--text-body); line-height: 1.5; color: var(--color-ink-2); }
  .hc-cta-acts { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-sm); margin-top: var(--space-lg); }

  @media (max-width: 60rem) {
    .hc-scorebox, .hc-head-text, .hc-sec-label, .hc-rsec-body { grid-column: 1 / -1; }
    .hc-sec-label { max-width: none; }
    .hc-bars, .hc-grid { grid-template-columns: minmax(0, 1fr); }
    .hc-half, .hc-half + .hc-half { padding: var(--space-lg) 0; border-left: 0; }
    .hc-half + .hc-half { border-top: var(--rule-hair) solid var(--color-rule); }
  }
  @media (max-width: 40rem) {
    .hc-area-row { grid-template-columns: minmax(0, 1fr) auto; }
    .hc-area-chip { justify-self: end; }
    .hc-area-rowtext { grid-column: 1 / -1; }
    .hc-bar-row { grid-template-columns: 6rem minmax(0, 1fr) 2rem; column-gap: var(--space-sm); }
  }
  @media (prefers-reduced-motion: reduce) { .hc-x { transition: none; } }

  /* Print-only header/footer (hidden on screen; shown only when printing the report) */
  .hc-prt-head, .hc-prt-rule, .hc-prt-meta, .hc-prt-foot, .hc-cta-printlink { display: none; }
  .hc-prt-head { align-items: baseline; justify-content: space-between; gap: var(--space-md); }
  .hc-prt-brand { display: flex; align-items: baseline; gap: var(--space-xs); }
  .hc-prt-brand svg { align-self: center; }
  .hc-prt-wm { font-family: var(--font-wordmark); font-size: var(--text-xl); line-height: 1; color: var(--color-ink); }
  .hc-prt-an { font-family: var(--font-outlier); font-weight: 500; font-size: var(--text-sm); color: var(--color-ink-2); }
  .hc-prt-kicker { font-family: var(--font-display); font-weight: 700; font-size: var(--text-md); color: var(--color-ink); }
  .hc-prt-rule { height: 0; margin: var(--space-xs) 0; border-top: var(--rule-double); }
  .hc-prt-meta { margin-bottom: var(--space-md); font-size: var(--text-xs); color: var(--color-ink-2); }
  .hc-prt-foot { margin-top: var(--space-md); padding-top: var(--space-xs); border-top: var(--rule-hair) solid var(--color-rule-2); }
  .hc-prt-foot > span { display: block; font-size: var(--text-xs); line-height: 1.5; color: var(--color-ink-2); }

  @media print {
    @page { margin: 14mm 14mm 12mm; }

    /* Printing the REPORT: suppress site chrome + marketing siblings + in-app chrome */
    body.hc-report-view :is(nav, footer, .mast, .skip), body.hc-report-view .intro, body.hc-report-view .below,
