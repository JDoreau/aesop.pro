---
// /resources/dashboard-audit — the interactive Dashboard Audit Checklist.
// Migrated from public/resources/dashboard-audit/index.html (legacy static
// HTML) into the Astro system: BaseLayout supplies head/Seo/GA4/Nav/Footer;
// this page keeps its own content, styles, and the audit engine. The engine
// uses global functions via inline onclick handlers, so the script must be
// is:inline (a bundled module script would scope those functions away).
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Dashboard Audit Checklist — Aesop Analytics"
  description="30 scored questions to audit any dashboard for decision alignment, metric clarity, data trust, design, governance, and operational health. Free — no email required."
  ogTitle="Dashboard Audit Checklist — Aesop Analytics"
  ogDescription="Score any dashboard in under 20 minutes across six dimensions — and walk away with a prioritised fix list. Free, no email required."
  path="/resources/dashboard-audit"
>
<header class="page-head">
  <div class="container da-head">
    <div class="da-head-main">
      <h1>The Dashboard Audit.</h1>
      <p class="lead">Thirty questions across six dimensions — purpose, definitions, data trust, design, governance, and operational health. Score any dashboard in under twenty minutes and walk away with a prioritized list of exactly what to fix, with a fix hint behind every weak answer.</p>
      <ul class="meta">
        <li>Free interactive tool</li>
        <li>30 questions</li>
        <li>6 categories</li>
        <li>No email required</li>
      </ul>
    </div>
    <div class="da-preview">
      <h2 class="da-prev-label">Example audit results</h2>
      <ul class="da-prev-list">
        <li class="da-prev-row"><span class="da-prev-cat">Purpose &amp; Alignment</span><span class="da-prev-pill y">4/5</span></li>
        <li class="da-prev-row"><span class="da-prev-cat">Metric Definitions</span><span class="da-prev-pill n">1/5</span></li>
        <li class="da-prev-row"><span class="da-prev-cat">Data Trust</span><span class="da-prev-pill p">3/5</span></li>
        <li class="da-prev-row"><span class="da-prev-cat">Design &amp; Usability</span><span class="da-prev-pill y">4/5</span></li>
        <li class="da-prev-row"><span class="da-prev-cat">Governance</span><span class="da-prev-pill n">1/5</span></li>
        <li class="da-prev-row"><span class="da-prev-cat">Operational Health</span><span class="da-prev-pill p">3/5</span></li>
      </ul>
      <p class="da-prev-note">Illustrative &mdash; your scores will differ</p>
    </div>
  </div>
</header>
<div class="da-prog" id="da-prog">
  <div class="container da-prog-in">
    <span class="da-prog-label" id="da-prog-label">Progress</span>
    <div class="da-prog-track"><div class="da-prog-fill" id="da-prog-fill"></div></div>
    <span class="da-prog-count" id="da-prog-count">0 / 30</span>
  </div>
</div>
<div class="da-body"><div class="container">

    <div class="da-cat" id="cat-01">
      <div class="da-cat-hdr">
        <h2><span class="num">01</span> Purpose &amp; Alignment</h2>
        <p>A dashboard without a clear decision it supports is decoration. These questions test whether this dashboard earns its place.</p>
      </div>
      <div class="da-q" id="q1" data-cat="01" data-val="">
        <div class="da-q-num">Question 1 of 30</div>
        <div class="da-q-text">Does this dashboard directly support a named, recurring decision?</div>
        <div class="da-q-hint">If nobody can name the decision this dashboard supports, it likely does not belong in the reporting estate.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(1,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(1,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(1,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Define the primary decision this dashboard supports before spending more time on it. <a href="/insights/dashboards-not-trusted/">Read more</a></p></div>
      </div>
      <div class="da-q" id="q2" data-cat="01" data-val="">
        <div class="da-q-num">Question 2 of 30</div>
        <div class="da-q-text">Can you identify which meeting or workflow this dashboard is used in?</div>
        <div class="da-q-hint">A dashboard not attached to a specific cadence is rarely used when it matters.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(2,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(2,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(2,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Map this dashboard to a specific meeting or decision cycle &mdash; or consider retiring it. <a href="/insights/reporting-not-dashboard-redesign/">Read more</a></p></div>
      </div>
      <div class="da-q" id="q3" data-cat="01" data-val="">
        <div class="da-q-num">Question 3 of 30</div>
        <div class="da-q-text">Is the intended audience clearly defined and limited to people who act on this data?</div>
        <div class="da-q-hint">Dashboards built for everybody are optimised for nobody.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(3,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(3,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(3,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Name the primary audience and ask if everyone with access actually uses it. <a href="/insights/dashboard-design-basics/">Read more</a></p></div>
      </div>
      <div class="da-q" id="q4" data-cat="01" data-val="">
        <div class="da-q-num">Question 4 of 30</div>
        <div class="da-q-text">Do recipients use this dashboard to make decisions &mdash; not just to check in?</div>
        <div class="da-q-hint">There is a meaningful difference between a dashboard people consult before decisions and one they glance at and close.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(4,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(4,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(4,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Ask the last three people who opened this dashboard what decision they were making. <a href="/insights/dashboards-not-trusted/">Read more</a></p></div>
      </div>
      <div class="da-q" id="q5" data-cat="01" data-val="">
        <div class="da-q-num">Question 5 of 30</div>
        <div class="da-q-text">Are the metrics connected to documented business goals or OKRs?</div>
        <div class="da-q-hint">Metrics that float free from business goals tend to measure activity, not impact.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(5,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(5,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(5,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Trace each metric to a business objective. Remove the ones that do not connect. <a href="/insights/data-strategy/">Read more</a></p></div>
      </div>
    </div>

    <div class="da-cat" id="cat-02">
      <div class="da-cat-hdr">
        <h2><span class="num">02</span> Metric Definitions</h2>
        <p>Poorly defined metrics undermine every decision this dashboard supports. These questions check whether the numbers mean what people think they mean.</p>
      </div>
      <div class="da-q" id="q6" data-cat="02" data-val="">
        <div class="da-q-num">Question 6 of 30</div>
        <div class="da-q-text">Are all metrics defined in writing &mdash; business definition, formula, and source?</div>
        <div class="da-q-hint">If the definition lives only in someone’s head, the dashboard will produce disagreements, not decisions.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(6,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(6,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(6,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Start a KPI dictionary entry for every metric on this dashboard. <a href="/insights/kpi-dictionary/">Read more</a></p></div>
      </div>
      <div class="da-q" id="q7" data-cat="02" data-val="">
        <div class="da-q-num">Question 7 of 30</div>
        <div class="da-q-text">Does every metric have a single named business owner?</div>
        <div class="da-q-hint">A metric owned by everybody is owned by nobody.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(7,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(7,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(7,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Assign a named owner to each metric. One person, not a team. <a href="/insights/kpi-owner/">Read more</a></p></div>
      </div>
      <div class="da-q" id="q8" data-cat="02" data-val="">
        <div class="da-q-num">Question 8 of 30</div>
        <div class="da-q-text">Is the authoritative source system documented for each metric?</div>
        <div class="da-q-hint">Without a documented source, reconciliation disputes are inevitable.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(8,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(8,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(8,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Document the source system for each metric and treat it as the single authoritative source. <a href="/insights/kpi-dictionary/">Read more</a></p></div>
      </div>
      <div class="da-q" id="q9" data-cat="02" data-val="">
        <div class="da-q-num">Question 9 of 30</div>
        <div class="da-q-text">Are the filters, exclusions, and grain documented for each metric?</div>
        <div class="da-q-hint">Most metric disagreements are about what is included and excluded, not the formula.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(9,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(9,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(9,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Add explicit filter and exclusion documentation to each KPI definition. <a href="/insights/hidden-cost-conflicting-kpis/">Read more</a></p></div>
      </div>
      <div class="da-q" id="q10" data-cat="02" data-val="">
        <div class="da-q-num">Question 10 of 30</div>
        <div class="da-q-text">Would Finance, Operations, and Sales agree on the key metric definitions?</div>
        <div class="da-q-hint">Cross-functional disagreement on definitions is the leading cause of untrustworthy reporting.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(10,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(10,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(10,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Run a definition alignment session. Surface the conflicts now. <a href="/insights/hidden-cost-conflicting-kpis/">Read more</a></p></div>
      </div>
    </div>

    <div class="da-cat" id="cat-03">
      <div class="da-cat-hdr">
        <h2><span class="num">03</span> Data Trust &amp; Quality</h2>
        <p>Technically correct data is not the same as trusted data. These questions probe whether people actually rely on what they see.</p>
      </div>
      <div class="da-q" id="q11" data-cat="03" data-val="">
        <div class="da-q-num">Question 11 of 30</div>
        <div class="da-q-text">Do recipients trust these numbers enough to use them without verifying elsewhere?</div>
        <div class="da-q-hint">If people run parallel spreadsheets to check the dashboard, it has a trust problem regardless of accuracy.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(11,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(11,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(11,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Run a trust survey with the primary audience. Low trust is a separate problem from low accuracy. <a href="/insights/dashboards-not-trusted/">Read more</a></p></div>
      </div>
      <div class="da-q" id="q12" data-cat="03" data-val="">
        <div class="da-q-num">Question 12 of 30</div>
        <div class="da-q-text">Is there a clear process for who investigates when a metric looks wrong?</div>
        <div class="da-q-hint">Without a defined escalation path, data errors fester. The same issue surfaces in every review.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(12,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(12,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(12,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Define a data error escalation process. Name the technical owner for each metric. <a href="/insights/kpi-owner/">Read more</a></p></div>
      </div>
      <div class="da-q" id="q13" data-cat="03" data-val="">
        <div class="da-q-num">Question 13 of 30</div>
        <div class="da-q-text">Is the data refresh time documented and visible to the audience?</div>
        <div class="da-q-hint">Stakeholders making decisions with stale data do not know what they do not know.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(13,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(13,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(13,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Add a visible last-updated timestamp and document the refresh cadence. <a href="/insights/kpi-dictionary/">Read more</a></p></div>
      </div>
      <div class="da-q" id="q14" data-cat="03" data-val="">
        <div class="da-q-num">Question 14 of 30</div>
        <div class="da-q-text">Are there known data quality issues affecting any metric?</div>
        <div class="da-q-hint">Undocumented known issues are trust destroyers. Transparency builds more trust than silence.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(14,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(14,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(14,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Document known issues visibly on or near the affected metric. <a href="/insights/dashboards-not-trusted/">Read more</a></p></div>
      </div>
      <div class="da-q" id="q15" data-cat="03" data-val="">
        <div class="da-q-num">Question 15 of 30</div>
        <div class="da-q-text">Has the data powering this dashboard been validated in the past 12 months?</div>
        <div class="da-q-hint">Data pipelines drift. A validation check once a year is minimum hygiene.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(15,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(15,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(15,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Schedule an annual data validation. Log and share the results. <a href="/insights/data-strategy/">Read more</a></p></div>
      </div>
    </div>

    <div class="da-cat" id="cat-04">
      <div class="da-cat-hdr">
        <h2><span class="num">04</span> Design &amp; Usability</h2>
        <p>A well-governed dashboard that is confusing to read will not change behaviour. These questions assess whether the design serves the decision.</p>
      </div>
      <div class="da-q" id="q16" data-cat="04" data-val="">
        <div class="da-q-num">Question 16 of 30</div>
        <div class="da-q-text">Can a new team member understand this dashboard without a walkthrough?</div>
        <div class="da-q-hint">If the dashboard requires institutional knowledge to interpret, it depends on people, not systems.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(16,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(16,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(16,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Add a one-paragraph description of what the dashboard is for and how to read it. <a href="/insights/dashboard-design-basics/">Read more</a></p></div>
      </div>
      <div class="da-q" id="q17" data-cat="04" data-val="">
        <div class="da-q-num">Question 17 of 30</div>
        <div class="da-q-text">Does the dashboard have a clear visual hierarchy &mdash; the most important metric is most prominent?</div>
        <div class="da-q-hint">When everything is equally prominent, nothing is.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(17,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(17,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(17,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Identify the one metric that matters most. Make it visually dominant. <a href="/insights/dashboard-design-basics/">Read more</a></p></div>
      </div>
      <div class="da-q" id="q18" data-cat="04" data-val="">
        <div class="da-q-num">Question 18 of 30</div>
        <div class="da-q-text">Is the dashboard free of decorative elements that do not drive decisions?</div>
        <div class="da-q-hint">Chartjunk and redundant visualisations dilute attention.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(18,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(18,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(18,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Remove any chart or metric the audience has not used in a decision in the past quarter. <a href="/insights/dashboard-design-basics/">Read more</a></p></div>
      </div>
      <div class="da-q" id="q19" data-cat="04" data-val="">
        <div class="da-q-num">Question 19 of 30</div>
        <div class="da-q-text">Are chart types appropriate for the data being shown?</div>
        <div class="da-q-hint">Mismatched chart types obscure insight. Pie charts for comparisons, bar charts for rankings.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(19,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(19,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(19,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Review each visualisation against the question it answers. Replace mismatched chart types. <a href="/insights/gestalt-perception/">Read more</a></p></div>
      </div>
      <div class="da-q" id="q20" data-cat="04" data-val="">
        <div class="da-q-num">Question 20 of 30</div>
        <div class="da-q-text">Does the dashboard lead the reader toward a clear conclusion or next step?</div>
        <div class="da-q-hint">A dashboard that requires the audience to figure out what it means has done half the job.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(20,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(20,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(20,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Add thresholds or conditional formatting that shows whether each metric is healthy or needs attention. <a href="/insights/dashboard-design-basics/">Read more</a></p></div>
      </div>
    </div>

    <div class="da-cat" id="cat-05">
      <div class="da-cat-hdr">
        <h2><span class="num">05</span> Governance &amp; Ownership</h2>
        <p>Governance is what separates a dashboard that ages well from one that silently drifts into unreliability.</p>
      </div>
      <div class="da-q" id="q21" data-cat="05" data-val="">
        <div class="da-q-num">Question 21 of 30</div>
        <div class="da-q-text">Is there a single named owner responsible for this dashboard’s accuracy?</div>
        <div class="da-q-hint">Shared ownership is no ownership. When a number is wrong, one person should be the obvious call.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(21,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(21,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(21,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Name a single dashboard owner. Document the name on or near the dashboard. <a href="/insights/governance-operators/">Read more</a></p></div>
      </div>
      <div class="da-q" id="q22" data-cat="05" data-val="">
        <div class="da-q-num">Question 22 of 30</div>
        <div class="da-q-text">Is there a defined process for requesting changes or reporting data issues?</div>
        <div class="da-q-hint">Without an intake process, change requests come through ad hoc channels and do not get prioritised.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(22,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(22,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(22,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Create a simple intake form or documented process for change requests. <a href="/insights/governance-operators/">Read more</a></p></div>
      </div>
      <div class="da-q" id="q23" data-cat="05" data-val="">
        <div class="da-q-num">Question 23 of 30</div>
        <div class="da-q-text">Has this dashboard been reviewed and updated within the past six months?</div>
        <div class="da-q-hint">A dashboard not reviewed in six months is likely drifting from its original purpose.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(23,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(23,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(23,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Schedule a semi-annual review. Verify the metrics still reflect the decisions being made. <a href="/insights/reporting-not-dashboard-redesign/">Read more</a></p></div>
      </div>
      <div class="da-q" id="q24" data-cat="05" data-val="">
        <div class="da-q-num">Question 24 of 30</div>
        <div class="da-q-text">Is this dashboard listed in a reporting inventory with owner and purpose documented?</div>
        <div class="da-q-hint">If it is not in a reporting inventory, it is invisible to governance.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(24,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(24,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(24,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Add this dashboard to a reporting inventory. <a href="/insights/governance-operators/">Read more</a></p></div>
      </div>
      <div class="da-q" id="q25" data-cat="05" data-val="">
        <div class="da-q-num">Question 25 of 30</div>
        <div class="da-q-text">Is there a change log for significant changes made to this dashboard?</div>
        <div class="da-q-hint">Without a change log, unexplained metric shifts create confusion.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(25,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(25,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(25,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Start a simple change log: date, description, and the person who made the change. <a href="/insights/kpi-dictionary/">Read more</a></p></div>
      </div>
    </div>

    <div class="da-cat" id="cat-06">
      <div class="da-cat-hdr">
        <h2><span class="num">06</span> Operational Health</h2>
        <p>A well-designed, trusted dashboard that breaks or requires manual effort creates operational debt.</p>
      </div>
      <div class="da-q" id="q26" data-cat="06" data-val="">
        <div class="da-q-num">Question 26 of 30</div>
        <div class="da-q-text">Is this dashboard fully automated &mdash; no manual steps to produce or refresh it?</div>
        <div class="da-q-hint">Manual reporting is brittle. Every manual step is a failure point and a recurring time cost.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(26,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(26,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(26,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Identify which manual steps exist and prioritise eliminating the highest-effort ones first. <a href="/insights/bad-reporting-blocks-ai/">Read more</a></p></div>
      </div>
      <div class="da-q" id="q27" data-cat="06" data-val="">
        <div class="da-q-num">Question 27 of 30</div>
        <div class="da-q-text">Does the dashboard load and refresh within a reasonable time for its intended use?</div>
        <div class="da-q-hint">A dashboard that takes five minutes to load will not be used in a meeting.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(27,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(27,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(27,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Measure load time. If it exceeds 30 seconds, investigate query optimisation. <a href="/insights/data-strategy/">Read more</a></p></div>
      </div>
      <div class="da-q" id="q28" data-cat="06" data-val="">
        <div class="da-q-num">Question 28 of 30</div>
        <div class="da-q-text">Do the right people have access &mdash; and only those people?</div>
        <div class="da-q-hint">Overly broad access creates security risk. Overly narrow access creates workarounds.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(28,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(28,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(28,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Review the access list. Remove access for people who have not used it in six months. <a href="/insights/governance-operators/">Read more</a></p></div>
      </div>
      <div class="da-q" id="q29" data-cat="06" data-val="">
        <div class="da-q-num">Question 29 of 30</div>
        <div class="da-q-text">Does this dashboard have a clear owner for the underlying data pipeline?</div>
        <div class="da-q-hint">Dashboard ownership and pipeline ownership are separate. Both need a named person.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(29,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(29,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(29,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Identify and document the technical owner of the data pipeline. <a href="/insights/kpi-owner/">Read more</a></p></div>
      </div>
      <div class="da-q" id="q30" data-cat="06" data-val="">
        <div class="da-q-num">Question 30 of 30</div>
        <div class="da-q-text">Does this dashboard have fewer than 20 metrics or visualisations?</div>
        <div class="da-q-hint">Dashboards with more than 20 elements are almost never used as intended.</div>
        <div class="da-btns">
          <button class="da-btn" aria-pressed="false" onclick="answer(30,1,this,'yes')">Yes</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(30,0.5,this,'partial')">Partially</button>
          <button class="da-btn" aria-pressed="false" onclick="answer(30,0,this,'no')">No</button>
        </div>
        <div class="da-fix-hint"><p>Archive anything not referenced in a decision in the past six months. <a href="/insights/dashboard-design-basics/">Read more</a></p></div>
      </div>
    </div>
</div></div>
<div class="da-results" id="da-results" style="display:none">
  <div class="container"><div class="da-results-in">

    <div class="da-score-hero">
      <p class="da-score">
        <span class="da-score-num" id="res-score">0</span>
        <span class="da-score-denom">out of 30</span>
      </p>
      <h2 id="res-verdict-title"></h2>
    </div>

    <h3 class="da-section-title">Score by category</h3>
    <div class="da-breakdown" id="res-breakdown"></div>

    <h3 class="da-section-title">Analysis</h3>
    <div class="da-narrative" id="res-narrative"></div>

    <h3 class="da-section-title" id="fixes-label" style="display:none">Priority fixes</h3>
    <div class="da-fixes-list" id="res-fixes"></div>

  </div></div>
</div>
</BaseLayout>

<!-- is:global is required here: the audit engine creates result-section DOM
     (bar rows, narrative, fix cards) at runtime via innerHTML/createElement,
     which never receives Astro's scope attribute — scoped styles would leave
     those elements unstyled. All selectors are da- prefixed, so no leak. -->
<style is:global>
  /* The Dashboard Audit: an app screen in the Newsprint system. Ruled rows on an
     eight-column working measure; status shows as a tick or a bar fill beside its
     word or number, never as coloured type. Tokens only. */

  /* ── The head: the claim on the left, a sample listing on the right ── */
  .da-head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap-columns); row-gap: var(--space-xl); align-items: end; }
  .da-head-main { grid-column: 1 / span 8; min-width: 0; }
  .da-preview { grid-column: 9 / -1; min-width: 0; }
  .da-prev-label { max-width: none; font-size: var(--text-lg); line-height: 1.2; letter-spacing: -0.01em; }
  .da-prev-list { margin: var(--space-sm) 0 0; padding: 0; list-style: none; border-top: var(--rule-hair) solid var(--color-rule-2); }
  .da-prev-row { display: flex; justify-content: space-between; align-items: center; gap: var(--space-md); padding-block: var(--space-xs); border-bottom: var(--rule-hair) solid var(--color-rule); }
  .da-prev-cat { font-size: var(--text-md); line-height: 1.4; color: var(--color-ink-2); }
  .da-prev-pill { display: inline-flex; align-items: center; gap: var(--space-xs); font-family: var(--font-outlier); font-weight: 500; font-size: var(--text-sm); line-height: 1.4; font-variant-numeric: tabular-nums; color: var(--color-ink); white-space: nowrap; }
  .da-prev-pill::before { content: ""; width: var(--space-md); height: 3px; background: var(--status-mid); }
  .da-prev-pill.y::before { background: var(--status-high); }
  .da-prev-pill.n::before { background: var(--status-low); }
  .da-prev-note { padding-top: var(--space-xs); font-size: var(--text-sm); font-weight: 500; line-height: 1.4; color: var(--color-muted); }

  /* ── Progress: the page's one sticky element ── */
  .da-prog { position: sticky; top: 0; z-index: var(--z-sticky); background: var(--color-paper); border-bottom: var(--rule-hair) solid var(--color-rule); }
  .da-prog-in { display: flex; align-items: center; gap: var(--space-md); padding-block: var(--space-sm); }
  .da-prog-label { flex: 0 1 auto; font-size: var(--text-sm); font-weight: 500; line-height: 1.4; color: var(--color-ink-2); }
  .da-prog-track { flex: 1 1 0; min-width: var(--space-xl); height: 6px; background: var(--status-track); }
  .da-prog-fill { width: 0%; height: 100%; background: var(--color-ink); }
  .da-prog-count { flex: 0 0 auto; font-family: var(--font-outlier); font-weight: 500; font-size: var(--text-sm); line-height: 1.4; font-variant-numeric: tabular-nums; color: var(--color-ink); white-space: nowrap; }

  /* ── Six categories, each under a double rule ── */
  .da-body { padding-block: var(--space-xl) var(--space-3xl); }
  .da-cat { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap-columns); padding-top: var(--space-lg); border-top: var(--rule-double); }
  .da-cat + .da-cat { margin-top: var(--space-2xl); }
  .da-cat > * { grid-column: 1 / span 8; min-width: 0; }
  .da-cat-hdr { padding-bottom: var(--space-xl); }
  .da-cat-hdr h2 { max-width: none; font-size: var(--text-head); line-height: 1.08; }
  .da-cat-hdr h2 .num { margin-right: var(--space-2xs); font-variant-numeric: tabular-nums lining-nums; }
  .da-cat-hdr p { margin-top: var(--space-sm); max-width: 46rem; color: var(--color-ink-2); }

  /* ── A question: a ruled row; its answer shows as a short tick on the rule ── */
  .da-q { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-xs); padding-block: var(--space-lg); border-top: var(--rule-hair) solid var(--color-rule); }
  .da-q:last-child { border-bottom: var(--rule-hair) solid var(--color-rule); }
  .da-q::before { content: ""; position: absolute; top: calc(-1 * var(--rule-hair)); left: 0; width: var(--space-xl); height: 3px; background: transparent; }
  .da-q.answered-yes::before { background: var(--status-high); }
  .da-q.answered-partial::before { background: var(--status-mid); }
  .da-q.answered-no::before { background: var(--status-low); }
  .da-q-num { font-size: var(--text-sm); font-weight: 500; line-height: 1.4; color: var(--color-muted); }
  .da-q-text { max-width: 46rem; font-size: var(--text-lg); font-weight: 500; line-height: 1.35; color: var(--color-ink); text-wrap: pretty; }
  .da-q-hint { max-width: 46rem; font-size: var(--text-md); line-height: 1.5; color: var(--color-ink-2); text-wrap: pretty; }

  /* the three answers: one segmented group of square buttons; the choice is an ink fill */
  .da-btns { display: flex; margin-top: var(--space-xs); }
  .da-btn { min-height: 40px; padding: 0 var(--space-lg); border: var(--rule-hair) solid var(--color-rule-2); border-left-width: 0; border-radius: 0; background: none; font-family: var(--font-body); font-weight: 500; font-size: var(--text-md); line-height: 1; color: var(--color-ink); white-space: nowrap; cursor: pointer; transition: background-color var(--dur-short) var(--ease-out), transform var(--dur-micro) var(--ease-out); }
  .da-btn:first-child { border-left-width: var(--rule-hair); }
  .da-btn:hover { background: var(--color-paper-2); }
  .da-btn:active { transform: translateY(1px); }
  .da-btn:focus-visible { position: relative; z-index: var(--z-base); outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .da-btn:disabled { opacity: 0.55; cursor: not-allowed; transform: none; }
  .da-btn.sel-yes, .da-btn.sel-partial, .da-btn.sel-no { background: var(--color-ink); border-color: var(--color-ink); color: var(--color-on-ink); }
  .da-btn.sel-yes:hover, .da-btn.sel-partial:hover, .da-btn.sel-no:hover { background: var(--color-ink-2); }
  @media (pointer: coarse) { .da-btn { min-height: 44px; } }
  @media (prefers-reduced-motion: reduce) { .da-btn { transition: none; } }

  /* the fix hint: a well, shown under a No */
  .da-fix-hint { display: none; align-self: stretch; margin-top: var(--space-xs); padding: var(--space-sm) var(--space-md); background: var(--color-paper-2); border-block: var(--rule-hair) solid var(--color-rule); }
  .da-q.answered-no .da-fix-hint { display: block; }
  .da-fix-hint p { font-size: var(--text-md); line-height: 1.5; color: var(--color-ink-2); }

  /* ── Results: the score, the verdict, six bars, the analysis, the fixes ── */
  .da-results { padding-bottom: var(--space-3xl); }
  .da-results-in { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap-columns); padding-top: var(--space-xl); border-top: var(--rule-double); }
  .da-results-in > * { grid-column: 1 / span 8; min-width: 0; }
  .da-score-hero { display: flex; flex-direction: column; gap: var(--space-lg); }
  .da-score { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2xs) var(--space-md); max-width: none; }
  .da-score-num { font-family: var(--font-display); font-weight: 700; font-size: var(--text-poster); line-height: 0.9; letter-spacing: var(--tracking-display); font-variant-numeric: lining-nums; color: var(--color-ink); }
  .da-score-denom { font-size: var(--text-lg); font-weight: 500; line-height: 1.4; color: var(--color-ink-2); white-space: nowrap; }
  .da-score-hero h2 { max-width: 24ch; font-size: var(--text-head); line-height: 1.08; }
  .da-section-title { max-width: none; margin-top: var(--space-2xl); margin-bottom: var(--space-md); font-size: var(--text-xl); line-height: 1.2; }

  .da-breakdown { border-bottom: var(--rule-hair) solid var(--color-rule); }
  .da-bar-row { display: grid; grid-template-columns: minmax(0, 14rem) minmax(0, 1fr) 3rem; column-gap: var(--space-md); align-items: center; padding-block: var(--space-sm); border-top: var(--rule-hair) solid var(--color-rule); }
  .da-bar-row:first-child { border-top-color: var(--color-rule-2); }
  .da-bar-label { font-size: var(--text-md); font-weight: 500; line-height: 1.4; color: var(--color-ink); }
  .da-bar-track { height: 10px; background: var(--status-track); }
  .da-bar-fill { height: 100%; }
  .da-bar-pct { font-family: var(--font-outlier); font-weight: 500; font-size: var(--text-sm); line-height: 1.4; font-variant-numeric: tabular-nums; text-align: right; color: var(--color-ink); white-space: nowrap; }

  .da-narrative p { max-width: var(--measure); color: var(--color-ink-2); }
  .da-narrative p + p { margin-top: var(--space-md); }

  .da-fixes-list { border-bottom: var(--rule-hair) solid var(--color-rule); }
  .da-fix-card { padding-block: var(--space-md); border-top: var(--rule-hair) solid var(--color-rule); }
  .da-fix-card:first-child { border-top-color: var(--color-rule-2); }
  .da-fix-card h4 { max-width: 46rem; }
  .da-fix-card p { margin-top: var(--space-xs); font-size: var(--text-md); line-height: 1.5; color: var(--color-ink-2); }

  @media (max-width: 60rem) {
    .da-head-main, .da-preview, .da-cat > *, .da-results-in > * { grid-column: 1 / -1; }
    .da-preview { max-width: 28rem; }
  }
  @media (max-width: 40rem) {
    .da-preview { max-width: none; }
    .da-btn { padding: 0 var(--space-md); }
    .da-bar-row { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "label pct" "track track"; row-gap: var(--space-2xs); }
    .da-bar-label { grid-area: label; }
    .da-bar-pct { grid-area: pct; }
    .da-bar-track { grid-area: track; }
  }
  @media print { .da-prog { display: none; } }
</style>

<script is:inline>
const fixes={};
let answered=0, auditBand='';
const TOTAL=30;
const CAT_LABELS={"01":"Purpose & Alignment","02":"Metric Definitions","03":"Data Trust & Quality","04":"Design & Usability","05":"Governance & Ownership","06":"Operational Health"};

document.querySelectorAll('.da-q').forEach(q=>{
  const fEl=q.querySelector('.da-fix-hint');
  if(fEl) fixes[q.id]={title:q.querySelector('.da-q-text').textContent.trim(),text:fEl.innerHTML};
});

function answer(n,v,btn,type){
  const q=document.getElementById('q'+n);
  if(q.dataset.val==='') answered++;
  q.dataset.val=v;
  q.querySelectorAll('.da-btn').forEach(b=>{b.classList.remove('sel-yes','sel-partial','sel-no');b.setAttribute('aria-pressed','false');});
  btn.classList.add('sel-'+type);
  btn.setAttribute('aria-pressed','true');
  q.classList.remove('answered-yes','answered-partial','answered-no');
  q.classList.add('answered-'+type);
  updateProgress();
  if(answered===TOTAL) showResults();
}

function updateProgress(){
  const pct=(answered/TOTAL)*100;
  document.getElementById('da-prog-fill').style.width=pct+'%';
  document.getElementById('da-prog-count').textContent=answered+' / '+TOTAL;
  if(answered===TOTAL){
    document.getElementById('da-prog').classList.add('complete');
    document.getElementById('da-prog-label').textContent='Audit complete — results below';
  }
}

function buildNarrative(catScores, pct){
  const sorted=Object.entries(catScores)
    .map(([cat,s])=>({cat,pct:s.total/s.max,name:CAT_LABELS[cat]}))
    .sort((a,b)=>a.pct-b.pct);
  const weakest=sorted.filter(c=>c.pct<0.6);
  const wNames=weakest.slice(0,2).map(c=>c.name.toLowerCase());
  let p1='',p2='';
  if(pct>=0.83){
    p1='This dashboard is performing well across most dimensions — scores this high are relatively uncommon. The fundamentals are sound: the data is trusted, the metrics are defined, and meaningful governance is in place.'+(weakest.length?' The one area worth continued attention is '+weakest[0].name.toLowerCase()+', which scored below what the rest of the audit would predict.':'');
    p2='The priority at this stage is maintenance: keeping governance cadences running, reviewing the dashboard semi-annually, and ensuring it evolves alongside the decisions it supports.';
  } else if(pct>=0.6){
    const urgency=weakest[0]&&weakest[0].pct<0.4?(weakest[0].name+' is the most urgent gap — without clear ownership and definitions, trust will erode the next time a number looks wrong and nobody can explain why.'):'These are not cosmetic issues; addressing them now prevents the more expensive problem of rebuilding trust after it breaks.';
    p1='The dashboard has solid foundations — it is being used and broadly trusted — but the audit surfaces structural gaps in '+wNames.join(' and ')+' that will quietly compound over time. '+urgency;
    p2='The good news: these are almost always process problems, not technical ones. They can be addressed systematically without redesigning the dashboard itself. Work through the priority fixes below and consider a governance review within the next 60 days.';
  } else if(pct>=0.33){
    p1='The dashboard has significant structural issues that are likely already affecting how much people rely on it. The gaps in '+wNames.join(' and ')+' are the core reasons dashboards get worked around. Recipients are probably verifying numbers elsewhere or simply not trusting what they see.';
    p2='Before investing more in design or data, address the governance and definition issues flagged below. A redesign on top of weak foundations produces a better-looking problem.';
  } else {
    p1='The audit results indicate that this dashboard needs fundamental work before further investment. The structural gaps — particularly in '+wNames.join(' and ')+' — suggest it may be creating the appearance of data governance without the substance.';
    p2='Pause any design or feature work and address the foundational issues first. At this score level it is worth asking directly: should this dashboard be rebuilt from scratch — or retired?';
  }
  return '<p>'+p1+'</p><p>'+p2+'</p>';
}

function showResults(){
  const r=document.getElementById('da-results');
  r.style.display='block';
  setTimeout(()=>r.scrollIntoView({block:'start'}),100);

  let total=0;
  document.querySelectorAll('.da-q').forEach(q=>{total+=parseFloat(q.dataset.val)||0;});
  const rounded=Math.round(total*2)/2;

  const scoreEl=document.getElementById('res-score');
  scoreEl.textContent=rounded;

  const pct=rounded/30;
  let title, band;
  if(pct>=0.83){title='Strong — this dashboard is well-built';band='Strong';}
  else if(pct>=0.6){title='Functional — improvements will compound value';band='Functional';}
  else if(pct>=0.33){title='At risk — fundamental issues are undermining usefulness';band='At risk';}
  else{title='Critical — retire or rebuild before further investment';band='Critical';}
  auditBand=band;
  document.getElementById('res-verdict-title').textContent=title;

  const catScores={};
  document.querySelectorAll('.da-q').forEach(q=>{
    const c=q.dataset.cat;
    if(!catScores[c]) catScores[c]={total:0,max:0};
    catScores[c].total+=parseFloat(q.dataset.val)||0;
    catScores[c].max+=1;
  });

  const bd=document.getElementById('res-breakdown');
  bd.innerHTML='';
  const catLines=[];
  Object.entries(catScores).sort((a,b)=>a[0].localeCompare(b[0])).forEach(([cat,s])=>{
    const p=s.total/s.max;
    const col=p>=0.8?'var(--status-high)':p>=0.5?'var(--status-mid)':'var(--status-low)';
    const row=document.createElement('div'); row.className='da-bar-row';
    const sc=s.total%1===0?s.total:s.total.toFixed(1);
    row.innerHTML='<span class="da-bar-label">'+CAT_LABELS[cat]+'</span><div class="da-bar-track"><div class="da-bar-fill" style="width:0%;background:'+col+'" data-w="'+Math.round(p*100)+'"></div></div><span class="da-bar-pct">'+sc+'/'+s.max+'</span>';
    bd.appendChild(row);
    catLines.push(CAT_LABELS[cat]+': '+sc+'/'+s.max);
  });
  setTimeout(()=>{document.querySelectorAll('.da-bar-fill').forEach(b=>{b.style.width=b.dataset.w+'%';});},100);

  document.getElementById('res-narrative').innerHTML=buildNarrative(catScores, pct);

  const fixItems=[];
  document.querySelectorAll('.da-q.answered-no').forEach(q=>{if(fixes[q.id])fixItems.push(fixes[q.id]);});
  if(fixItems.length<3) document.querySelectorAll('.da-q.answered-partial').forEach(q=>{if(fixItems.length<5&&fixes[q.id])fixItems.push(fixes[q.id]);});
  const fl=document.getElementById('fixes-label'),fe=document.getElementById('res-fixes');
  if(fixItems.length>0){
    fl.style.display='block'; fe.innerHTML='';
    fixItems.slice(0,5).forEach(f=>{
      const c=document.createElement('div'); c.className='da-fix-card';
      c.innerHTML='<h4>'+f.title+'</h4><div>'+f.text+'</div>';
      fe.appendChild(c);
    });
  }

}

</script>
