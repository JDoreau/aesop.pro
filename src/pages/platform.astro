---
// platform.astro — Aesop Manteia, the product. The deepest product page and
// the destination the reface promotes to (SITE-DIRECTION §1). Reconciles the
// old "The Record"/"The Oracle" marketing labels to the NAMING-CANON plain
// names (The Portal (Aesop Stoa) / The Agent (Aesop Pythia)), adds the
// honest status chips + the honesty rail, and states every claim at the code's
// maturity level. URL preserved: "/platform".
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import PromiseBand from "../components/PromiseBand.astro";
import SpineCard from "../components/SpineCard.astro";
import HonestyRail from "../components/HonestyRail.astro";
import CtaBand from "../components/CtaBand.astro";
import Reveal from "../components/Reveal.astro";

const title = 'Aesop Manteia — the data-governance platform | Aesop Analytics';
const description = "Manteia maps your data estate from metadata, makes every metric's owner and definition visible, and lets anyone ask a plain question — answered from your governed data, with a citation for every claim, or an honest 'that isn't governed yet.'";
const ogDescription = "Trust you can see, and keep. Your estate mapped, governed, and answerable — with a citation for every claim, honestly staged.";
---

<BaseLayout title={title} description={description} path="/platform" ogDescription={ogDescription}>
<div class="reface">

  <!-- ── HERO ── -->
  <Hero eyebrow="Aesop Manteia · the data-governance platform">
    <h1>Trust you can <span class="em">see</span> — and keep.</h1>
    <Fragment slot="sub"><strong>Manteia</strong> gives your data a governed record it can stand behind: your whole estate mapped from metadata, every metric's owner and definition in plain view, and an agent that answers about it &mdash; grounded only in your governed data, with a citation for every claim.</Fragment>
    <Fragment slot="cta">
      <a href="/diagnostic/" class="btn">See it on your estate</a>
      <a href="/assessment/" class="btn ghost">How the engagement works</a>
    </Fragment>
    <div slot="note" class="hero-note reveal" style="animation:rise .7s cubic-bezier(.2,.7,.2,1) .36s forwards">Built on a deterministic core &mdash; it computes, it doesn't guess.</div>
  </Hero>

  <!-- ── TRANSITION ── -->
  <PromiseBand parts={["Most governance dies in a slide deck.", "This one stays alive in the work."]} />

  <!-- ── THE THREE PARTS ── -->
  <section class="parts band-navy ae-host ae-mark" id="product" style="--ae-size:min(40vw,460px); --ae-left:-4%; --ae-bottom:-24%; --ae-opacity:.05;">
    <div class="wrap">
      <div class="sec-label">What it is</div>
      <h2 class="parts-h">Three parts, one continuous system.</h2>
      <p class="lede parts-lede">Manteia takes the estate from raw systems to a question you can ask in plain English &mdash; and every step is auditable, because none of it is guesswork. Here is each part, and exactly how far along it is.</p>

      <div class="spine">
        <SpineCard step="01" name="The Scribe" greek="Aesop Graphion" status="dep" statusLabel="Deployed — proven engine">
          Point it at your BI files, your warehouse catalog, or a simple export. It reads what actually exists &mdash; tables, fields, metrics, and the lineage between them &mdash; and builds a typed map of your estate. No manual documentation, no months of interviews to draw the picture.
        </SpineCard>
        <SpineCard step="02" name="The Portal" greek="Aesop Stoa" status="dep" statusLabel="Deployed — log in today" highlight={true}>
          The map becomes a navigable, canonical record. Every metric, who owns it, where it's defined, which reports disagree, and &mdash; most tellingly &mdash; what no one owns at all. The gaps render in red. That red is the work, now visible to the people who can fix it. The write layer is live too: ratify a definition, assign an owner, log a request, and the record updates.
        </SpineCard>
        <SpineCard step="03" name="The Agent" greek="Aesop Pythia" status="prev" statusLabel="Live grounded answers now · live-data querying in preview">
          Ask a plain question &mdash; "which numbers does no one own?", "is this metric trustworthy?" &mdash; and the agent answers from your governed estate alone, with a citation behind every claim. It cannot invent a number or an owner: if the answer isn't in your data, it says so. Asking your live data directly is the newest capability, in preview.
        </SpineCard>
      </div>

      <div class="rail-wrap">
        <HonestyRail
          deployed="The governed portal with secure login, the estate map from metadata, grounded answers with citations, and the write layer &mdash; ratify a definition, assign an owner, log a request, and the record updates on a real database."
          preview="The agent asking questions of your live data directly, and regenerating governed reports from the map. The guard and query loop are ratified and building; we'll show you exactly how far along it is."
          roadmap="Native Power BI report generation and automated Gold-layer design. Real work, honestly not finished &mdash; and we never present it as shipped. (Tableau auto-generation is not something we promise.)"
        />
      </div>
    </div>
  </section>

  <!-- ── FROM ESTATE TO ANSWERS ── -->
  <section class="flow band-navy" id="how">
    <div class="wrap">
      <div class="sec-label">How it works</div>
      <h2 class="flow-h">From a pile of systems to a question you can ask.</h2>
      <p class="lede flow-lede">The same pipeline runs for a fifty-table startup or a fifty-thousand-table enterprise &mdash; it reads the catalog, it doesn't guess what you have.</p>
      <div class="flow-grid">
        <div class="flow-step"><div class="fs-n">1</div><div class="fs-name">Connect</div><div class="fs-desc">A read-only export or catalog from each system. We ask for a key, never a copy of your data.</div></div>
        <div class="flow-step"><div class="fs-n">2</div><div class="fs-name">Map</div><div class="fs-desc">Every table, field, metric, and lineage edge, normalized into one typed map of the estate.</div></div>
        <div class="flow-step"><div class="fs-n">3</div><div class="fs-name">Govern</div><div class="fs-desc">Owners, definitions, and the gaps surfaced &mdash; what's contested, what's unowned, what's never been governed.</div></div>
        <div class="flow-step"><div class="fs-n">4</div><div class="fs-name">Answer</div><div class="fs-desc">A record anyone can navigate and an agent anyone can ask &mdash; every claim traceable to its source.</div></div>
      </div>
    </div>
  </section>

  <!-- ── CONTINUITY (ties to the on-ramp) ── -->
  <section class="cont band-paper">
    <div class="wrap">
      <div class="cont-grid">
        <div class="cont-left">
          <div class="sec-label">Why it matters</div>
          <h2>The engagement establishes trust. Manteia keeps it.</h2>
          <p>A Reporting Clarity Assessment maps your estate and names the gaps. Historically, that picture started going stale the day it was delivered &mdash; definitions drift, new reports appear, owners change roles. Manteia is the living version of that work: it updates as the estate changes, so the governance you paid for is still true a year later.</p>
          <p>Between engagements, Manteia is what your team navigates and the agent is who they ask. It's the difference between a one-time clean-up and a practice that sustains itself.</p>
          <a href="/assessment/" class="cont-link">See the on-ramp</a>
        </div>
        <div class="cont-right">
          <div class="cont-card">
            <div class="cc-k">An engagement, made continuous</div>
            <div class="cc-row"><span class="cc-was">A report that ages</span><span class="cc-arrow">&rarr;</span><span class="cc-now">A record that updates</span></div>
            <div class="cc-row"><span class="cc-was">A spreadsheet of owners</span><span class="cc-arrow">&rarr;</span><span class="cc-now">Owners visible in context</span></div>
            <div class="cc-row"><span class="cc-was">"Ask the analyst"</span><span class="cc-arrow">&rarr;</span><span class="cc-now">Ask the estate directly</span></div>
            <div class="cc-row"><span class="cc-was">Trust you took on faith</span><span class="cc-arrow">&rarr;</span><span class="cc-now">Trust with a citation</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── TRUST & SAFETY ── -->
  <section class="safe band-paper2" id="safe">
    <div class="wrap">
      <div class="sec-label">Built to be trusted</div>
      <h2 class="safe-h">Why you can stand behind every number it shows.</h2>
      <div class="safe-grid">
        <div class="safe-item">
          <div class="si-h">It computes, it doesn't guess</div>
          <p>The map, the lineage, and every governance finding are produced by deterministic code reading your own systems &mdash; not by a model's opinion. The same inputs always give the same answer, and you can audit how it was reached.</p>
        </div>
        <div class="safe-item">
          <div class="si-h">The agent cites or refuses</div>
          <p>The agent answers only from your governed estate and attaches the source to every claim. It is built so it cannot fabricate a number, an owner, or a definition &mdash; the honest "that isn't governed yet" is a feature, not a failure.</p>
        </div>
        <div class="safe-item">
          <div class="si-h">Metadata, never your data</div>
          <p>We work from metadata and exports, not a copy of your warehouse &mdash; we ask for a key, not a copy. The platform is model-agnostic and can run inside your own walls, so sensitive estates never leave the building.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── FINAL CTA ── -->
  <CtaBand eyebrow="See it for real">
    <h2>Watch your own estate become a living record.</h2>
    <Fragment slot="sub">A focused 30-minute look, no slide deck. If Manteia isn't the right fit for where you are, we'll tell you plainly.</Fragment>
    <Fragment slot="cta">
      <a href="/diagnostic/" class="btn on-light">See it on your estate</a>
      <a href="/work/" class="btn ghost">See recent work</a>
    </Fragment>
  </CtaBand>

  <Reveal selector=".spine-card,.flow-step,.safe-item,.cc-row,.honesty-rail .rr" />
</div>

<style>
  .parts { padding:92px 0; }
  .parts-h { color:#fff; margin-bottom:16px; max-width:22ch; }
  .parts-lede { color:#C4BDAE; max-width:64ch; margin-bottom:44px; }
  .rail-wrap { margin-top:40px; }
  .flow { padding:88px 0; }
  .flow-h { color:#fff; margin-bottom:16px; max-width:24ch; }
  .flow-lede { color:#C4BDAE; max-width:62ch; margin-bottom:40px; }
  .cont { padding:88px 0; }
  .cont-grid { display:grid; grid-template-columns:1.05fr .95fr; gap:56px; align-items:center; }
  @media(max-width:820px){ .cont-grid { grid-template-columns:1fr; gap:32px; } }
  .cont-left h2 { margin-bottom:18px; line-height:1.12; max-width:18ch; }
  .cont-left p { font-size:17px; color:var(--slate); line-height:1.65; font-weight:300; margin-bottom:16px; }
  .cont-link { display:inline-flex; align-items:center; gap:6px; margin-top:10px; font-size:13.5px; font-weight:700; color:var(--navy); letter-spacing:.04em; text-transform:uppercase; }
  .cont-link::after { content:"\2192"; }
  .cont-link:hover { color:var(--twine); }
  .cont-card { background:var(--navy); border-radius:8px; padding:32px 30px; border-top:3px solid var(--twine); }
  .cc-k { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.18em; color:var(--twine); margin-bottom:20px; }
  .cc-row { display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:12px; padding:13px 0; border-bottom:1px solid rgba(255,255,255,.08); }
  .cc-row:last-child { border-bottom:none; }
  .cc-was { font-size:14px; color:#8FA4B8; font-weight:300; text-align:right; }
  .cc-arrow { color:var(--twine); font-size:14px; }
  .cc-now { font-size:14px; color:#fff; font-weight:500; }
  .safe { padding:88px 0; }
  .safe-h { margin-bottom:40px; max-width:24ch; }
</style>

</BaseLayout>
