---
// services.astro — the human on-ramp to the product (reframed for the reface).
// Services are demoted below the product per the new order (SITE-DIRECTION §1):
// this page is "the fastest way to see Manteia on your own estate," not "how
// the company works." Offer ladder + all anchors (#assessment/#sprint/
// #governance/#retainer) preserved (homepage + footer deep-link to them);
// services + FAQ JSON-LD kept for SEO; "The Record"/"The Oracle" reconciled to
// canon plain names. URL preserved: "/services".
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
const title = 'The on-ramp — assessment & engagements | Aesop Analytics';
const description = 'The human on-ramp to Aesop Manteia: a fixed-fee Reporting Clarity Assessment that maps your estate into the product, plus the modernization sprint, governance kit, and fractional retainer that grow from it. Free diagnostic to start.';
const ogDescription = "The fastest way to see Manteia on your own estate — start with the Reporting Clarity Assessment.";

const servicesSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Aesop Analytics",
  url: "https://aesopanalytics.com",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Reporting modernization & data governance on-ramp",
    itemListElement: [
      {
        "@type": "Offer",
        priceSpecification: { "@type": "PriceSpecification", priceCurrency: "USD", minPrice: 5000, maxPrice: 9500 },
        itemOffered: { "@type": "Service", name: "Reporting Clarity Assessment", description: "A 2–3 week fixed-fee reporting audit that maps your estate into Manteia and delivers a prioritized 30/60/90-day modernization roadmap." },
      },
      {
        "@type": "Offer",
        priceSpecification: { "@type": "PriceSpecification", priceCurrency: "USD", minPrice: 15000, maxPrice: 40000 },
        itemOffered: { "@type": "Service", name: "Executive Reporting Modernization Sprint", description: "Build or redesign a high-value executive reporting package — dashboard, KPI dictionary, source-of-truth map, and standards guide." },
      },
      {
        "@type": "Offer",
        priceSpecification: { "@type": "PriceSpecification", priceCurrency: "USD", minPrice: 12000, maxPrice: 35000 },
        itemOffered: { "@type": "Service", name: "Data Governance Starter Kit", description: "Practical governance for operators — KPI dictionary, owner matrix, intake, certification rules, and an operating cadence." },
      },
      {
        "@type": "Offer",
        priceSpecification: { "@type": "PriceSpecification", priceCurrency: "USD", minPrice: 3500, maxPrice: 12000 },
        itemOffered: { "@type": "Service", name: "Fractional Analytics Operations Retainer", description: "Ongoing senior analytics operating support on a defined monthly scope." },
      },
    ],
  },
};

const faqs = [
  { q: "Where does every engagement start?", a: "With a free 30-minute Reporting Trust Diagnostic call. No commitment required. If there's a clear fit after that conversation, the logical next step is a paid Reporting Clarity Assessment — which maps your estate into Manteia. You won't be pushed into a larger engagement before you have a clear picture of the problem." },
  { q: "How is work priced?", a: "Fixed fee per project, scoped during discovery. No hourly billing for project work — it misaligns incentives and makes budgeting impossible. For retainer arrangements, a monthly fixed scope with a defined set of deliverables." },
  { q: "We already have Power BI / Tableau. Can you work within what we have?", a: "Yes — and that's the most common scenario. Most engagements start with an organization that already has a BI tool but isn't getting the value from it, either because the reports weren't built well or because the data underneath them isn't trusted. Working within an existing environment is the norm." },
  { q: "Is Aesop a firm or just one person?", a: "Principal-led. Jonathan Doreau is the accountable lead and your point of contact on every engagement — the person who does the diagnosis and the delivery, with no bait-and-switch handoff to a junior team after the sales call. When a problem needs depth in a specific area, he draws on a small circle of independent senior specialists he has worked with for years — but they work behind the scenes, on Aesop's tooling and the product build, never between you and the work. You always deal with the principal." },
  { q: 'What makes the Assessment different from a free "audit"?', a: "Depth and structure. A free audit is a conversation. The Reporting Clarity Assessment is a 2–3 week structured engagement with a defined methodology (the TRUST framework), 10 specific deliverables, stakeholder interviews, and an executive-ready output — and it maps your estate into Manteia, so you leave with a living system, not a static deck." },
  { q: "What if the Assessment shows we don't need a bigger project?", a: "That's a completely valid outcome. The Assessment is designed to be useful on its own — the inventory, roadmap, and quick wins are actionable regardless of whether you continue to a Sprint. If the findings suggest your reporting environment is actually in better shape than expected, the honest answer is: take the quick wins yourself and revisit later." },
];
---

<BaseLayout title={title} description={description} path="/services" ogDescription={ogDescription} schema={servicesSchema}>
<div class="reface">

  <div class="page-hero ae-host ae-mark" style="--ae-size:min(40vw,460px); --ae-right:-2%; --ae-top:-20%; --ae-opacity:.07;">
    <div class="page-hero-in">
      <div class="eyebrow">The on-ramp</div>
      <h1>The fastest way to see Manteia on your own estate.</h1>
      <p>The product leads; this is how you get there. Every engagement begins with a low-risk assessment that maps your estate into Manteia &mdash; not a six-month transformation commitment. Here's the full on-ramp, from the free diagnostic to the fractional retainer.</p>
      <div class="btn-row" style="margin-top:30px">
        <a href="/platform/" class="btn">See the product first</a>
        <a href="/diagnostic/?utm_source=site&utm_medium=internal&utm_campaign=services-hero-diagnostic" class="btn ghost">Book a diagnostic</a>
      </div>
    </div>
  </div>

  <!-- OFFER LADDER VISUAL -->
  <div class="ladder band-paper2">
    <div class="ladder-inner">
      <div class="sec-label" style="margin-bottom:20px">The on-ramp ladder &mdash; start low-risk, expand as trust grows</div>
      <div class="ladder-steps">
        <div class="ladder-step free"><div class="ls-num">0</div><div class="ls-name">Reporting Trust Diagnostic</div><div class="ls-price">Free · 30 min</div></div>
        <div class="ladder-step hl"><div class="ls-num">1</div><div class="ls-name">Reporting Clarity Assessment</div><div class="ls-price">$5K–$9.5K</div></div>
        <div class="ladder-step"><div class="ls-num">2</div><div class="ls-name">Modernization Sprint</div><div class="ls-price">$15K–$40K</div></div>
        <div class="ladder-step"><div class="ls-num">3</div><div class="ls-name">Governance Starter Kit</div><div class="ls-price">$12K–$35K</div></div>
        <div class="ladder-step"><div class="ls-num">4</div><div class="ls-name">Fractional Retainer</div><div class="ls-price">$3.5K–$12K/mo</div></div>
        <a href="/platform/" class="ladder-step cont" style="text-decoration:none"><div class="ls-num">&#8734;</div><div class="ls-name">Aesop Manteia</div><div class="ls-price">The living system you keep</div></a>
      </div>
    </div>
  </div>

  <!-- DIAGNOSTIC (free) -->
  <section class="svc band-paper2">
    <div class="wrap">
      <div class="svc-grid">
        <div class="svc-meta">
          <div class="svc-tag">Entry point — always free</div>
          <h2>Reporting Trust Diagnostic Call</h2>
          <div class="svc-price">Free</div><br>
          <div class="svc-duration">30 minutes</div>
        </div>
        <div class="svc-body">
          <p>The starting point for every engagement. A 30-minute conversation to understand your reporting environment, identify where trust is breaking down, and determine whether a structured assessment would be useful. No pitch, no slide deck, no commitment.</p>
          <p>If there's a clear fit, the logical next step is a paid Reporting Clarity Assessment. If not, we'll say so &mdash; and point you somewhere better.</p>
          <div class="svc-cta"><a href="/diagnostic/?utm_source=site&utm_medium=internal&utm_campaign=services-card-diagnostic" class="btn twine">Book a free diagnostic &rarr;</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ASSESSMENT -->
  <section class="svc" id="assessment">
    <div class="wrap">
      <div class="svc-grid">
        <div class="svc-meta">
          <div class="svc-tag">&#9733; Flagship first offer</div>
          <h2>Reporting Clarity Assessment</h2>
          <div class="svc-price">$5,000–$9,500</div><br>
          <div class="svc-duration">2–3 weeks · Fixed fee</div>
        </div>
        <div class="svc-body">
          <p>A structured review of your entire reporting estate &mdash; dashboards, spreadsheets, KPI definitions, data sources, and governance gaps &mdash; mapped into Manteia. The output is an executive-ready assessment, a prioritized 30/60/90-day modernization roadmap, and a living governed record you keep. You'll know <em>exactly</em> where reporting trust is breaking down and what to fix first.</p>
          <p>This is the right starting point because it doesn't require committing to a large transformation. It gives you a clear, concrete picture of the problem and a practical plan &mdash; before you spend serious money on implementation. Think the dashboards themselves are the issue? Start with a <a href="/bi-dashboard-audit/">BI dashboard audit</a> &mdash; the same diagnostic, framed around the charts.</p>
          <div class="dels">
            <div class="dels-label">10 deliverables included</div>
            <div class="del-list">
              <div class="del-item">Reporting inventory &mdash; every dashboard, spreadsheet, and recurring report</div>
              <div class="del-item">Stakeholder pain summary from structured interviews</div>
              <div class="del-item">Dashboard and report usage review &mdash; trusted vs. ignored</div>
              <div class="del-item">Metric conflict list &mdash; where definitions diverge across teams</div>
              <div class="del-item">KPI definition gaps &mdash; metrics without owners or agreed calculations</div>
              <div class="del-item">Data source map &mdash; systems, owners, known quality issues</div>
              <div class="del-item">Manual reporting burden analysis &mdash; time cost of spreadsheet work</div>
              <div class="del-item">Quick-win recommendations &mdash; what to fix in the next 30 days</div>
              <div class="del-item">30/60/90-day modernization roadmap with priorities, owners, and effort estimates</div>
              <div class="del-item">Your estate mapped into Manteia &mdash; the living governed record you keep</div>
            </div>
          </div>
          <div class="svc-cta"><a href="/assessment/?utm_source=site&utm_medium=internal&utm_campaign=services-card-assessment" class="btn twine">See the full assessment page &rarr;</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- SPRINT -->
  <section class="svc band-paper2" id="sprint">
    <div class="wrap">
      <div class="svc-grid">
        <div class="svc-meta">
          <div class="svc-tag">Implementation</div>
          <h2>Executive Reporting Modernization Sprint</h2>
          <div class="svc-price">$15,000–$40,000</div><br>
          <div class="svc-duration">4–8 weeks · Fixed fee</div>
        </div>
        <div class="svc-body">
          <p>Build or redesign a high-value reporting package for leadership &mdash; a cleaner, more trusted system built around the decisions that actually matter. Most often follows a Reporting Clarity Assessment, using the roadmap as the build plan.</p>
          <p>This is the core of <a href="/reporting-modernization-consulting/">reporting modernization</a> &mdash; fixing the layer underneath the dashboards, not just the dashboards themselves.</p>
          <div class="dels">
            <div class="dels-label">Typical deliverables</div>
            <div class="del-list">
              <div class="del-item">Executive KPI dashboard in Power BI or Tableau</div>
              <div class="del-item">KPI dictionary with definitions, formulas, owners, and source systems</div>
              <div class="del-item">Source-of-truth map &mdash; one authoritative system per domain</div>
              <div class="del-item">Reporting standards guide &mdash; naming conventions, layout standards, refresh rules</div>
              <div class="del-item">Dashboard rationalization plan &mdash; retirement candidates and consolidation</div>
              <div class="del-item">Stakeholder enablement session &mdash; training and governance handoff</div>
            </div>
          </div>
          <div class="svc-cta"><a href="/contact/?utm_source=site&utm_medium=internal&utm_campaign=services-sprint-contact" class="btn">Discuss a sprint &rarr;</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- GOVERNANCE -->
  <section class="svc" id="governance">
    <div class="wrap">
      <div class="svc-grid">
        <div class="svc-meta">
          <div class="svc-tag">Governance</div>
          <h2>Data Governance Starter Kit</h2>
          <div class="svc-price">$12,000–$35,000</div><br>
          <div class="svc-duration">4–6 weeks · Fixed fee</div>
        </div>
        <div class="svc-body">
          <p>Practical governance built for operators, not committees. A system that reduces metric confusion and creates shared definitions without creating bureaucracy. Designed to be maintained by your team after handoff &mdash; not dependent on Aesop to keep it running.</p>
          <div class="dels">
            <div class="dels-label">Typical deliverables</div>
            <div class="del-list">
              <div class="del-item">KPI dictionary &mdash; business and technical definitions, owners, formulas</div>
              <div class="del-item">Metric owner matrix &mdash; who owns each definition and approves changes</div>
              <div class="del-item">Data owner / steward RACI &mdash; by domain and system</div>
              <div class="del-item">Reporting intake process &mdash; how requests are received, triaged, and prioritized</div>
              <div class="del-item">Dashboard certification rules &mdash; what makes a report "official"</div>
              <div class="del-item">Report retirement process &mdash; how old reports are sunset without conflict</div>
              <div class="del-item">Governance meeting cadence and operating model</div>
            </div>
          </div>
          <div class="svc-cta"><a href="/contact/?utm_source=site&utm_medium=internal&utm_campaign=services-governance-contact" class="btn">Discuss governance work &rarr;</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- RETAINER -->
  <section class="svc band-paper2" id="retainer">
    <div class="wrap">
      <div class="svc-grid">
        <div class="svc-meta">
          <div class="svc-tag">Ongoing support</div>
          <h2>Fractional Analytics Operations Retainer</h2>
          <div class="svc-price">$3,500–$12,000/mo</div><br>
          <div class="svc-duration">Defined scope · Monthly</div>
        </div>
        <div class="svc-body">
          <p>Senior analytics operating support on an ongoing basis &mdash; for companies that need consistent analytics leadership but aren't ready to hire a full-time head of data. Scope is defined upfront and reviewed monthly. Not an open-ended engagement &mdash; specific deliverables, specific hours, clear expectations.</p>
          <p>Typical retainer work includes monthly reporting roadmap management, dashboard improvements, KPI governance, stakeholder intake, data quality monitoring, and executive reporting support. Vendor and tool evaluation as needed.</p>
          <div class="svc-cta"><a href="/contact/?utm_source=site&utm_medium=internal&utm_campaign=services-retainer-contact" class="btn">Discuss a retainer &rarr;</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRODUCT (the through-line) -->
  <section class="svc plat band-navy" id="platform">
    <div class="wrap">
      <div class="svc-grid">
        <div class="svc-meta">
          <div class="svc-tag">The through-line</div>
          <h2>Aesop Manteia</h2>
          <div class="svc-price plat-price">The product</div><br>
          <div class="svc-duration plat-dur">Continuous · yours to keep</div>
        </div>
        <div class="svc-body">
          <p class="plat-lede">Every engagement above maps into the same living system &mdash; <strong>Manteia</strong>. The estate gets mapped from metadata, the governance becomes visible, and your team gets an agent they can ask in plain English &mdash; grounded in the governed record of your data, with a citation for every claim. It's the difference between a one-time clean-up and a practice that sustains itself.</p>
          <div class="plat-parts">
            <div class="plat-part"><strong>The Scribe (Aesop Graphion)</strong> &mdash; maps your estate from metadata: tables, metrics, and lineage. <span class="ps">Deployed.</span></div>
            <div class="plat-part"><strong>The Portal (Aesop Stoa)</strong> &mdash; governance you can see: owners, definitions, and the red gaps. <span class="ps">Deployed &mdash; log in today.</span></div>
            <div class="plat-part"><strong>The Agent (Aesop Pythia)</strong> &mdash; answers grounded in the governed record of your data, with a source for every claim. <span class="ps">Live answers now; live-data querying in preview.</span></div>
          </div>
          <div class="svc-cta"><a href="/platform/" class="btn twine">Explore Manteia &rarr;</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <div class="how band-navy">
    <div class="how-in">
      <div class="eyebrow">How we work</div>
      <h2>The same three phases, every time.</h2>
      <p class="sub">Structure protects both sides. Every engagement moves through Discover, Build, and Handoff &mdash; in that order.</p>
      <div class="phases">
        <div class="phase"><div class="pn">01</div><h3>Discover &amp; Define</h3><p>Understand the actual problem &mdash; not just the stated one. Stakeholder interviews, current-state audit, and a clear scope document both parties agree to before any building begins.</p></div>
        <div class="phase"><div class="pn">02</div><h3>Build &amp; Iterate</h3><p>Short cycles with regular checkpoints. Working output early and often &mdash; not a black box followed by a big reveal. Problems surface when they're cheap to fix.</p></div>
        <div class="phase"><div class="pn">03</div><h3>Handoff &amp; Enable</h3><p>Every engagement ends with your team able to maintain what was built without depending on Aesop. Documentation, training, and structured knowledge transfer are part of the scope.</p></div>
      </div>
    </div>
  </div>

  <!-- WHAT WE DON'T DO -->
  <div class="dont band-paper2">
    <div class="wrap">
      <h2>What we don't do &mdash; and why it matters.</h2>
      <p class="dont-intro">This list is as important as the services list. These are the places where other engagements go wrong &mdash; and where a deliberate line has been drawn.</p>
      <div class="dont-grid">
        <div>
          <div class="dont-col-label is-label">What Aesop is</div>
          <div class="dont-items">
            <div class="dont-item is-item">A data-governance software company &mdash; the assessment is the on-ramp to Manteia, not the whole offering</div>
            <div class="dont-item is-item">Platform-agnostic &mdash; recommendations based on fit, not on margin</div>
            <div class="dont-item is-item">Principal-led &mdash; you get the expert on the work, not handed off to a junior team</div>
            <div class="dont-item is-item">Fixed-fee &mdash; you know the cost before work begins, no hourly billing surprises</div>
            <div class="dont-item is-item">Honest about the product &mdash; what's deployed, what's in preview, what's on the roadmap</div>
          </div>
        </div>
        <div>
          <div class="dont-col-label not-label">What Aesop is not</div>
          <div class="dont-items">
            <div class="dont-item not-item">A dashboard factory or generic BI contractor for hire</div>
            <div class="dont-item not-item">A tool reseller or platform partner with conflicted incentives</div>
            <div class="dont-item not-item">A data engineering body shop for ETL and pipeline work</div>
            <div class="dont-item not-item">A vague AI advisor or "AI strategy" shop</div>
            <div class="dont-item not-item">A staff augmentation vendor to backfill headcount</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- FAQ -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  })} />
  <section class="faq">
    <div class="wrap">
      <h2>Common questions.</h2>
      <div class="faq-list">
        {faqs.map((f) => <div class="faq-item"><div class="fq" set:html={f.q} /><div class="fa" set:html={f.a} /></div>)}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CtaBand eyebrow="Start here">
    <h2>Start with a free diagnostic call.</h2>
    <Fragment slot="sub">30 minutes to understand where reporting trust is breaking down &mdash; before committing to anything. If Manteia isn't the right fit for where you are, we'll tell you plainly.</Fragment>
    <Fragment slot="cta"><a href="/diagnostic/?utm_source=site&utm_medium=internal&utm_campaign=services-closing-diagnostic" class="btn on-light">See it on your estate</a></Fragment>
  </CtaBand>
</div>

<style>
  /* PAGE HERO */
  .page-hero { background:var(--navy); padding:80px 0 64px; }
  .page-hero-in { max-width:1080px; margin:0 auto; padding:0 32px; }
  .page-hero h1 { font-family:"Newsreader",Georgia,serif; font-weight:600; letter-spacing:-.01em; font-size:clamp(38px,5.6vw,68px); line-height:1.04; color:#fff; margin-bottom:18px; max-width:20ch; }
  .page-hero p { font-size:18px; color:#C4BDAE; font-weight:300; max-width:58ch; line-height:1.6; }
  /* OFFER LADDER OVERVIEW */
  .ladder { padding:56px 0; border-bottom:1px solid var(--rule); }
  .ladder-inner { max-width:1080px; margin:0 auto; padding:0 32px; }
  .ladder-steps { display:flex; align-items:stretch; gap:0; overflow-x:auto; }
  .ladder-step { flex:1; min-width:120px; background:#fff; border:1px solid var(--line); border-right:none; padding:20px 16px; text-align:center; position:relative; }
  .ladder-step:first-child { border-radius:6px 0 0 6px; }
  .ladder-step:last-child { border-right:1px solid var(--line); border-radius:0 6px 6px 0; }
  .ladder-step.hl { background:var(--navy); border-color:var(--navy); }
  .ls-num { font-family:"Newsreader",Georgia,serif; font-weight:600; font-size:22px; color:var(--twine); margin-bottom:6px; }
  .ls-name { font-size:12px; font-weight:700; color:var(--navy); line-height:1.3; }
  .ladder-step.hl .ls-name { color:#fff; }
  .ls-price { font-size:11px; color:var(--ink); margin-top:4px; }
  .ladder-step.hl .ls-price { color:#8A9FB8; }
  .ladder-step.free .ls-name { color:var(--twine); }
  .ladder-step.cont { border-top:3px solid var(--twine); }
  .ladder-step.cont .ls-num { color:var(--twine); }
  .ladder-step.cont .ls-name { color:var(--navy); }
  .ladder-step.cont .ls-price { color:var(--muted); }
  @media(max-width:600px){
    .ladder-steps { flex-direction:column; }
    .ladder-step { border-right:1px solid var(--line); border-bottom:none; border-radius:0!important; }
    .ladder-step:first-child { border-radius:6px 6px 0 0!important; }
    .ladder-step:last-child { border-bottom:1px solid var(--line); border-radius:0 0 6px 6px!important; }
  }
  /* SERVICE SECTIONS */
  .svc { padding:72px 0; border-bottom:1px solid var(--rule); scroll-margin-top:80px; }
  .svc-grid { display:grid; grid-template-columns:260px 1fr; gap:52px; }
  @media(max-width:760px){ .svc-grid { grid-template-columns:1fr; gap:24px; } }
  .svc-tag { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.18em; color:var(--twine); margin-bottom:10px; }
  .svc h2 { font-family:"Newsreader",Georgia,serif; font-weight:600; letter-spacing:-.01em; font-size:clamp(24px,3.2vw,34px); color:var(--navy); line-height:1.1; margin-bottom:16px; }
  .svc-price { display:inline-block; background:var(--navy); color:#fff; font-size:13px; font-weight:700; padding:6px 14px; border-radius:4px; margin-bottom:6px; }
  .svc-duration { font-size:13px; color:var(--muted); }
  /* PRODUCT SECTION — the through-line, on navy */
  .svc.plat { border-bottom:none; }
  .svc.plat h2 { color:#fff; }
  .plat-price { background:var(--twine)!important; color:var(--navy)!important; }
  .plat-dur { color:#8FA4B8!important; }
  .plat-lede { color:#C4BDAE; font-size:17px; line-height:1.65; font-weight:300; }
  .plat-parts { display:flex; flex-direction:column; gap:10px; margin:20px 0 24px; }
  .plat-part { font-size:15px; color:#C4BDAE; font-weight:300; padding-left:16px; border-left:2px solid var(--twine); line-height:1.5; }
  .plat-part strong { color:#fff; font-weight:700; }
  .plat-part .ps { color:#8FCBB2; font-weight:600; }
  .svc-body p { font-size:17px; color:var(--slate); line-height:1.65; font-weight:300; margin-bottom:18px; }
  .svc-body p:last-of-type { margin-bottom:0; }
