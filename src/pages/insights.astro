---
// insights.astro — the Writing hub: every article and field study as one index,
// grouped by pillar, with the pillar filter. Rendered entirely from
// src/data/insights.ts, so adding or moving an article is a data edit.
import BaseLayout from "../layouts/BaseLayout.astro";
import { hero, pillarButtons, featured, sections, sidebarPillars } from "../data/insights.ts";
import { linkHref, canonicalUrl } from "../data/nav.ts";
import type { Section } from "../data/insights.ts";
const title = 'Writing: Reporting Trust, KPIs & Dashboards | Aesop Analytics'
const description = 'Articles and field studies on reporting trust, KPI governance, dashboard design, and data strategy — by Jonathan Doreau.'
const ogDescription = "Articles and field studies on reporting trust, KPI definitions, dashboard design and data governance. Every dataset has a moral.";
// Count label derived from the rows, so it can never drift from the articles present.
const countLabel = (s: Section) => {
  const n = s.rows.length;
  const noun = s.pillar === 'field-study' ? 'study' : 'article';
  const plural = s.pillar === 'field-study' ? 'studies' : 'articles';
  return n + ' ' + (n === 1 ? noun : plural);
};
// A "·" in a data string is a separator: each part is set as its own fact.
const parts = (s: string) => s.split("·").map((x) => x.trim()).filter(Boolean);

// CollectionPage + ItemList JSON-LD for the hub: derived from the SAME data the
// page renders (insights.ts), so the list can never drift from the visible hub.
const listedRows = [featured, ...sections.flatMap((s) => s.rows)];
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title.split('|')[0].trim(),
  description,
  url: canonicalUrl("/insights"),
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: listedRows.length,
    itemListElement: listedRows.map((r, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: r.title,
      url: canonicalUrl(`/insights/${r.slug}`),
    })),
  },
};
---

<BaseLayout title={title} description={description} path="/insights" ogDescription={ogDescription} schema={schema}>

<header class="page-head">
  <div class="container">
    <h1>{hero.title}</h1>
    <p class="lead">Practical writing on reporting trust, KPI definitions, dashboard design, governance and AI readiness — plus the field studies, which also live under <a href="/publications/">Research</a>.</p>
  </div>
</header>

<section class="hub">
  <div class="pillars">
    <div class="container pillars__in">
      <span class="pillar-label" id="pillar-label">Pillar:</span>
      <div class="seg" role="group" aria-labelledby="pillar-label">
        {pillarButtons.map((p) => (
          <button type="button" class="pillar-btn" class:list={[{ on: p.cat === "all" }]} data-cat={p.cat} aria-pressed={p.cat === "all" ? "true" : "false"}>{p.label}</button>
        ))}
      </div>
    </div>
  </div>
  <div class="container hub__in">
    <div id="article-list" class="hub__list">

      <article class="feat-card" data-cat={featured.cat}>
        <div class="feat-card__text">
          <a href={linkHref(`/insights/${featured.slug}`)} class="feat-card__link"><h2>{featured.title}</h2></a>
          <p>{featured.desc}</p>
          <ul class="meta">
            {parts(featured.tag).map((t) => (<li>{t}</li>))}
            <li class="agate">{featured.time}</li>
          </ul>
          <a href={linkHref(`/insights/${featured.slug}`)} class="more" aria-label={`Read the study: ${featured.title}`}>Read the study</a>
        </div>
        <figure class="plate feat-card__plate">
          <img src={featured.image} alt={featured.imageAlt} loading="eager" fetchpriority="high" width="2160" height="2160" />
        </figure>
      </article>

      {sections.map((s) => (
        <div class="pillar-section" data-pillar={s.pillar}>
          <div class="ps-head">
            <h2>{s.heading}</h2>
            <span class="ps-count agate">{countLabel(s)}</span>
          </div>
          <ul class="index">
            {s.rows.map((r) => (
              <li class="art-row" data-cat={s.pillar}>
                <div class="index__main art-row__main">
                  <a class="index__link" href={linkHref(`/insights/${r.slug}`)}><h3 class="index__title">{r.title}</h3></a>
                  <p class="index__desc">{r.desc}</p>
                </div>
                <span class="index__kind art-row__kind">{r.pill}</span>
                <span class="index__fig">{r.time}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}

    </div>

    <aside class="sidebar">
      <div class="sb-block">
        <h3>The five content pillars</h3>
        <div class="pillar-list">
          {sidebarPillars.map((p) => (
            <button type="button" class="pl-item" data-cat={p.cat}><span>{p.label}</span> <span class="pl-ct agate">{p.count}</span></button>
          ))}
        </div>
      </div>
      <div class="sb-block">
        <h3>Free resource</h3>
        <p>The Reporting Trust Health Check — 11 areas across five pillars, 3 signal questions each. Score your reporting environment in about 10 minutes.</p>
        <a href="/resources/health-check/" class="more">Take the Health Check</a>
      </div>
    </aside>
  </div>
</section>

<style>
  /* ── The filter row: the page's one sticky element ── */
  .pillars { position: sticky; top: 0; z-index: var(--z-sticky); background: var(--color-paper); border-block: var(--rule-hair) solid var(--color-rule-2); }
  .pillars__in { display: flex; align-items: center; gap: var(--space-md); }
  .pillar-label { flex-shrink: 0; font-size: var(--text-sm); font-weight: 500; color: var(--color-muted); white-space: nowrap; }
  .pillars .seg { flex: 1; min-width: 0; }
  .pillars .seg > button { border-block-width: 0; min-height: 52px; }

  /* ── The hub: the index on eight columns, the side notes on the last three ── */
  .page-head { padding-bottom: var(--space-3xl); }
  .hub { padding-top: var(--space-md); }
  .hub__in { margin-top: var(--space-2xl); display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap-columns); row-gap: var(--space-2xl); align-items: start; }
  .hub__list { grid-column: 1 / span 8; min-width: 0; }
  .sidebar { grid-column: 10 / -1; position: sticky; top: var(--space-3xl); display: flex; flex-direction: column; gap: var(--space-xl); }

  /* the lead: the latest field study, with its plate */
  .feat-card { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); column-gap: var(--gap-columns); row-gap: var(--space-lg); align-items: start; padding-bottom: var(--space-2xl); }
  .feat-card__text { grid-column: 1 / span 5; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-md); }
  .feat-card__link { color: inherit; text-decoration: none; }
  .feat-card h2 { font-size: var(--text-head); line-height: 1.08; }
  .feat-card__link:hover h2 { text-decoration: underline; text-decoration-thickness: 2px; text-decoration-color: var(--color-accent); text-underline-offset: 0.14em; }
  .feat-card__text > p { color: var(--color-ink-2); }
  .feat-card__plate { grid-column: 6 / -1; }

  /* a pillar: its head between a double rule and the first row */
  .pillar-section { padding-bottom: var(--space-2xl); }
  .ps-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-md); padding-block: var(--space-lg) var(--space-md); border-top: var(--rule-double); }
  .ps-head h2 { max-width: none; font-size: var(--text-head); line-height: 1.08; }
  .ps-count { flex-shrink: 0; font-size: var(--text-sm); color: var(--color-muted); white-space: nowrap; }
  /* rows: title and line on six columns, the kind and the reading time at the right */
  .art-row.art-row { grid-template-columns: repeat(8, minmax(0, 1fr)); }
  .art-row__main { grid-column: 1 / span 5; }
  .art-row__kind { grid-column: 6 / span 2; text-align: right; white-space: nowrap; }
  .art-row .index__fig { grid-column: 8 / -1; }

  /* the side notes */
  .sb-block { padding-top: var(--space-md); border-top: var(--rule-hair) solid var(--color-rule-2); }
  .sb-block h3 { margin-bottom: var(--space-sm); font-size: var(--text-lg); line-height: 1.2; letter-spacing: -0.01em; }
  .sb-block p { margin-bottom: var(--space-md); font-size: var(--text-md); color: var(--color-ink-2); }
  .pillar-list { display: flex; flex-direction: column; }
  .pl-item { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-md); min-height: 44px; padding: var(--space-xs) 0; border: 0; border-bottom: var(--rule-hair) solid var(--color-rule); border-radius: 0; background: none; font-family: var(--font-body); font-size: var(--text-md); line-height: 1.3; color: var(--color-ink-2); text-align: left; cursor: pointer; }
  .pl-item:hover { color: var(--color-ink); text-decoration: underline; text-decoration-thickness: 2px; text-decoration-color: var(--color-accent); }
  .pl-item:active { color: var(--color-accent); }
  .pl-ct { font-size: var(--text-sm); color: var(--color-muted); }

  @media (max-width: 75rem) {
    .art-row__kind { display: none; }
    .art-row__main { grid-column: 1 / span 7; }
  }
  @media (max-width: 60rem) {
    .hub__list, .sidebar { grid-column: 1 / -1; }
    .sidebar { position: static; }
    .feat-card__text, .feat-card__plate { grid-column: 1 / -1; }
    .feat-card__plate { max-width: 24rem; }
    .art-row__main { grid-column: 1 / -1; order: 0; }
    .art-row .index__fig { grid-column: 1 / -1; justify-self: start; text-align: left; order: 1; }
  }
</style>

<script>
  function applyFilter(cat) {
    const rows = document.querySelectorAll('.art-row');
    const feat = document.querySelector('.feat-card');
    const groups = document.querySelectorAll('.pillar-section');
    if (cat === 'all') {
      rows.forEach((r) => (r.style.display = ''));
      groups.forEach((g) => (g.style.display = ''));
      if (feat) feat.style.display = '';
      return;
    }
    if (feat) feat.style.display = feat.dataset.cat === cat ? '' : 'none';
    rows.forEach((r) => { r.style.display = r.dataset.cat === cat ? '' : 'none'; });
    groups.forEach((g) => {
      const hasVisible = Array.from(g.querySelectorAll('.art-row')).some((r) => r.dataset.cat === cat);
      g.style.display = hasVisible ? '' : 'none';
    });
  }
  function selectPillar(cat) {
    if (!cat) return;
    document.querySelectorAll('.pillar-btn').forEach((b) => {
      const on = b.dataset.cat === cat;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', String(on));
    });
    applyFilter(cat);
  }
  document.querySelectorAll('.pillar-btn').forEach((btn) => {
    btn.addEventListener('click', () => selectPillar(btn.dataset.cat));
  });
  document.querySelectorAll('.pl-item').forEach((item) => {
    item.addEventListener('click', () => selectPillar(item.dataset.cat));
    item.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectPillar(item.dataset.cat); }
    });
  });
</script>

</BaseLayout>
