        <rect x="364" y="80" width="174" height="96" fill="var(--chart-surface)" stroke="var(--chart-axis)" stroke-width="1"/>
        <rect x="548" y="74" width="112" height="106" fill="var(--chart-surface)" stroke="var(--chart-axis)" stroke-width="1"/>
