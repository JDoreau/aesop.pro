<style>
  /* The typography pair: two figures side by side, each ruled on top in its verdict (brick: avoid; ink: do this).
     The card to avoid is set in the system's three faces at once, its figure in the slab's fixed-width old-style
     numerals (the system has no monospace face; this is its nearest); the card to follow, in the agate alone. */
  .compare { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--gap-columns); row-gap: var(--space-xl); }
  .compare .bad { border-top: 3px solid var(--color-accent); }
