<style>
  /* Stopgap for a shared cascade fault (reported): base.css zeroes the margin of every p, h2 and figure and
     caps .lead at 52ch with element and class selectors, and those out-rank the zero-specificity placement
     defaults in article.css. The rhythm this page needs is restated here with the same tokens; delete these
     five rules once the shared sheets are fixed. */
  .body > p { margin-top: var(--space-lg); }
  .body > .lead { margin-top: 0; max-width: var(--measure); }
  .body > .pull, .body > figure { margin-top: var(--space-2xl); }
  .body > h2 { margin-top: var(--space-3xl); }
  @media (max-width: 60rem) { .body > h2 { margin-top: var(--space-2xl); } }

  /* The seven components: ruled rows set two up, each numeral hung beside its head; the note takes the well */
  .components { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .components > * { padding-inline: 0 var(--space-lg); }
  .components > :nth-child(even) { padding-inline: var(--space-lg) 0; border-left: var(--rule-hair) solid var(--color-rule); }
  .components > .note { padding-right: var(--space-lg); border-top: 0; }
  .components h3 { display: grid; grid-template-columns: var(--space-2xl) minmax(0, 1fr); }
  .components .num { font-variant-numeric: tabular-nums lining-nums; }
  .components p { margin-left: var(--space-2xl); }
  @media (max-width: 60rem) {
    .components { grid-template-columns: minmax(0, 1fr); }
    .components > :nth-child(even) { padding-inline: 0; border-left: 0; }
    .components > .note { padding-inline: var(--space-lg); }
  }
  @media (max-width: 40rem) {
    .components h3 { grid-template-columns: auto minmax(0, 1fr); column-gap: var(--space-sm); }
    .components p { margin-left: 0; }
  }

  /* The sequence diagram: its second row is drawn eight units past the viewBox, so the drawing keeps room beneath */
  .illus svg { margin-bottom: var(--space-lg); }
  /* On a narrow column the drawing keeps a width at which its labels stay readable and scrolls sideways
     inside its own frame; the title and caption stay put. */
  .illus-scroll { overflow-x: auto; min-width: 0; }
  .illus-scroll svg { min-width: 48rem; }

  /* The case study: the ink band, its head beside the text; the label is set under the head as a dateline */
  .case { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 6fr); gap: var(--space-lg) var(--space-xl); align-items: start; }
  .case-head { display: flex; flex-direction: column-reverse; gap: var(--space-sm); }
  .case-head h3 { margin: 0; }
  .case-kind { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-sm); padding-top: var(--space-sm); border-top: var(--rule-hair) solid var(--color-rule-on-ink); font-size: var(--text-sm); font-weight: 500; line-height: 1.4; }
  .case-kind > * + * { padding-left: var(--space-sm); border-left: var(--rule-hair) solid var(--color-rule-on-ink); }
  .case-text > p + p { margin-top: var(--space-sm); }
  @media (max-width: 60rem) { .case { grid-template-columns: minmax(0, 1fr); } }

  /* The four failure modes: ruled rows on the text measure, the numeral set as the shared numbered rows set theirs
     (here the numerals are words in the markup, so no counter). The well that follows closes the list. */
  .failures { max-width: var(--measure); }
  .failures > * { display: grid; grid-template-columns: var(--space-2xl) minmax(0, 1fr); gap: var(--space-xs) var(--space-md); }
  .failures > :last-child { padding-bottom: 0; border-bottom: 0; }
  .failures .num { font-family: var(--font-display); font-weight: 700; font-size: var(--text-2xl); line-height: 1; font-variant-numeric: tabular-nums lining-nums; }
  @media (max-width: 40rem) { .failures > * { grid-template-columns: minmax(0, 1fr); } }
</style>
