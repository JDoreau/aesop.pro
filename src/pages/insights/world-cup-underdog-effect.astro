  </figure>

  <table>
    <caption>World Cup match competitiveness, by era</caption>
    <thead><tr><th>Era</th><th class="num">Avg. goal margin</th><th class="num">3+ goal blowouts</th><th class="num">Goals per match</th></tr></thead>
    <tbody>
