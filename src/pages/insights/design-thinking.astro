---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
const title = 'Design Thinking in Business Intelligence | Aesop Analytics'
const description = 'How user-centered design thinking applies to BI and reporting: empathy, iteration, and prototyping applied to dashboards and KPI frameworks.'
const kicker = "Article · Process & Method";
const headingHtml = "Design Thinking in Business Intelligence <span class=\"sub\">A practical guide to using a four-phase method when you know there’s a better answer but aren’t sure exactly what it is.</span>";
