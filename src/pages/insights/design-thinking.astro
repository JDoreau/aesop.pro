<style>
  /* WORKAROUND for a shared-style conflict (delete once it is fixed there): base.css resets the margin
     of p, h2, ol and figure with element selectors, and those outrank the zero-specificity :where()
     placement defaults in article.css, so the article's vertical rhythm collapses. The same values
     are restated here for the elements this page uses. */
  .body > p { margin-top: var(--space-lg); }
  .body > p:first-child { margin-top: 0; }
  .body > .lead { max-width: var(--measure); }
  .body > .phases { margin-top: var(--space-lg); }
  .body > .pull, .body > .illus { margin-top: var(--space-2xl); }
  .body > h2 { margin-top: var(--space-3xl); }
  @media (max-width: 60rem) { .body > h2 { margin-top: var(--space-2xl); } }

  /* The line under "The four phases.": the four names parted by hairlines, as the dateline is */
  .h2-sub.seq { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-sm); }
  .h2-sub.seq > span + span { padding-left: var(--space-sm); border-left: var(--rule-hair) solid var(--color-rule); }
  @media (max-width: 40rem) {
    .h2-sub.seq { display: grid; grid-template-columns: auto auto; justify-content: start; }
    .h2-sub.seq > span + span:nth-child(odd) { padding-left: 0; border-left: 0; }
  }

  /* The four phases: ruled rows set on the article's own columns. The numeral hangs in the margin
     column with its label under it, the text holds the measure, the running example takes a side column. */
  .phases > li { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); column-gap: var(--gap-columns); row-gap: var(--space-sm); align-items: baseline; padding-block: var(--space-xl); }
  .phases .pnum { grid-row: 1; grid-column: 1; font: 700 var(--text-xl)/1.2 var(--font-display); letter-spacing: var(--tracking-display); font-variant-numeric: tabular-nums lining-nums; }
  .phases .ptag { grid-row: 2; grid-column: 1; font-size: var(--text-sm); font-weight: 500; line-height: 1.4; color: var(--color-muted); white-space: nowrap; }
  .phases h3 { grid-row: 1; grid-column: 2 / span 5; margin: 0; font-size: var(--text-xl); }
  .phases p { grid-column: 2 / span 5; }
  .phases .example { grid-row: 1 / span 4; grid-column: 7 / -1; align-self: stretch; padding-left: var(--space-lg); border-left: var(--rule-hair) solid var(--color-rule); font-size: var(--text-md); color: var(--color-muted); }
  @media (max-width: 75rem) {
    .phases > li { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .phases h3, .phases p { grid-column: 2 / span 6; }
    .phases .example { grid-column: 8 / -1; }
  }
  @media (max-width: 60rem) {
    .phases > li { grid-template-columns: auto auto minmax(0, 1fr); column-gap: var(--space-sm); padding-block: var(--space-lg); }
    .phases h3 { grid-column: 2; }
    .phases .ptag { grid-row: 1; grid-column: 3; padding-left: var(--space-sm); border-left: var(--rule-hair) solid var(--color-rule); }
    .phases p { grid-column: 1 / -1; }
    .phases .example { grid-row: auto; grid-column: 1 / -1; padding-left: 0; border-left: 0; }
    .phases .example::before { content: ""; display: block; width: var(--space-xl); margin-bottom: var(--space-sm); border-top: var(--rule-hair) solid var(--color-rule-2); }
  }

  /* Do this, avoid this: two ruled columns. The rule over each says which it is: ink for do, brick for avoid */
  .protip { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-xl) var(--gap-columns); font-size: var(--text-body); line-height: 1.55; }
  .protip > div { min-width: 0; padding-top: var(--space-md); border-top: 3px solid var(--color-ink); }
  .protip > .dont { border-top-color: var(--color-accent); }
  .protip h3 { margin-bottom: var(--space-sm); font-size: var(--text-lg); letter-spacing: -0.01em; }
  .protip ul { padding: 0; list-style: none; border-top: var(--rule-hair) solid var(--color-rule); }
  .protip li { margin: 0; padding-block: var(--space-sm); border-bottom: var(--rule-hair) solid var(--color-rule); color: var(--color-ink-2); }
  @media (max-width: 40rem) { .protip { grid-template-columns: minmax(0, 1fr); } }

  /* On a phone the loop is drawn half again as wide as the column and centred: the drawing fills only the
     middle three-fifths of its frame, so the empty sides run off and the labels stay readable. */
  @media (max-width: 40rem) {
    .illus { display: grid; grid-template-columns: minmax(0, 1fr); overflow-x: clip; }
    .illus svg { justify-self: center; width: 150%; }
  }
</style>
