---
// about.astro — Jonathan Doreau, the author behind the site. Rewritten Nov 2026,
// when Aesop Analytics LLC closed and the site became his personal research and
// writing site: no services, no team, no booking. URL preserved: "/about".
import BaseLayout from "../layouts/BaseLayout.astro";
const title = 'About Jonathan Doreau | Aesop Analytics';
const description = 'Jonathan Doreau is a data and analytics professional in Nashville, TN, with 15+ years in reporting, business intelligence and data governance. Aesop Analytics is where he publishes his research and writing.';
const ogDescription = "15+ years turning distrusted data into reporting people rely on — and the research and writing that came out of it.";
---

<BaseLayout title={title} description={description} path="/about" ogDescription={ogDescription}>

  <!-- The author: the note beside the portrait -->
  <section class="about-hero">
    <div class="container about-hero__in">
      <div class="about-hero__text">
        <h1>Fifteen years of making numbers people can trust.</h1>
        <p class="lead">I’m Jonathan Doreau, a data and analytics professional in Nashville. I’ve spent my career taking fragmented, distrusted data environments and turning them into reporting people actually rely on. This site is where I publish what I learn along the way: field studies on the economy and on data, and practical writing on reporting, KPIs and governance.</p>
        <a href="https://www.linkedin.com/in/jonathan-doreau-1a00b233/" class="btn btn--secondary" target="_blank" rel="noopener">LinkedIn</a>
      </div>
      <figure class="plate about-hero__plate">
        <img src="/assets/jonathan-doreau.jpg" alt="Jonathan Doreau" width="680" height="850" loading="eager" fetchpriority="high" />
        <figcaption>
          <strong>Jonathan Doreau</strong>
          <ul class="meta">
            <li>Data &amp; Analytics</li>
            <li>Nashville, TN</li>
          </ul>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- THE CAREER ARC -->
  <section class="section arc">
    <div class="container">
      <div class="head">
        <h2>The career arc.</h2>
      </div>
      <div class="cols">
        <p>I started in finance &mdash; regulated reporting, risk dashboards, and the particular discipline that comes from working in environments where a wrong number has real consequences. That foundation taught me to care about data quality and governance before they became fashionable topics.</p>
        <p>From there: healthcare and research, including executive reporting and analytics for an <strong>NIH-funded research program</strong> &mdash; a context where data credibility mattered as much as the research itself, and where the reporting had to serve both operational leadership and external funders simultaneously. That’s where I developed a genuine appreciation for governance: the unglamorous work that makes everything downstream trustworthy.</p>
        <p>Real estate and nonprofit work came next, and what struck me most was how similar the data problems were across industries that seemed completely different. Fragmented sources, undefined metrics, reports that couldn’t be reconciled with each other, a data team spending most of its time answering one-off questions instead of building anything lasting. The patterns repeat &mdash; which is exactly why they can be studied and fixed with a method.</p>
        <p>Aesop Analytics is the name I publish under. It started in 2024 as a reporting-modernization practice; today it is the home for my research and writing.</p>
      </div>
      <ol class="index timeline">
        <li>
          <span class="index__kind timeline__when">Finance</span>
          <div class="index__main">
            <h3 class="index__title">Analytics &amp; BI Leadership</h3>
            <p class="timeline__org">Banking &amp; Financial Services</p>
            <p class="index__desc">Regulated reporting, risk dashboards, and data governance in a high-stakes, audit-intensive environment.</p>
          </div>
        </li>
        <li>
          <span class="index__kind timeline__when">Healthcare</span>
          <div class="index__main">
            <h3 class="index__title">Analytics &amp; Reporting</h3>
            <p class="timeline__org">Healthcare &amp; NIH Research</p>
            <p class="index__desc">Executive dashboards, program reporting, and analytics for an NIH-funded research initiative. Compliance-aware architecture, funder reporting, and operational KPIs.</p>
          </div>
        </li>
        <li>
          <span class="index__kind timeline__when">Real Estate</span>
          <div class="index__main">
            <h3 class="index__title">BI &amp; Data Strategy</h3>
            <p class="timeline__org">Real Estate</p>
            <p class="index__desc">Portfolio performance reporting, market analytics, and building a reporting governance practice from the ground up.</p>
          </div>
        </li>
        <li>
          <span class="index__kind timeline__when">Nonprofit</span>
          <div class="index__main">
            <h3 class="index__title">Analytics &amp; Impact Measurement</h3>
            <p class="timeline__org">Nonprofit Sector</p>
            <p class="index__desc">Program impact dashboards, board reporting, and outcome measurement &mdash; translating mission into metrics that funders and leadership could act on.</p>
          </div>
        </li>
        <li>
          <span class="index__kind timeline__when">2024 &rarr;</span>
          <div class="index__main">
            <h3 class="index__title">Research &amp; writing</h3>
            <p class="timeline__org">Aesop Analytics, Nashville, TN</p>
            <p class="index__desc">Field studies on the economy and on data, and practical writing on reporting, KPIs and governance &mdash; published on this site.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- TOOLS & TECHNICAL -->
  <section class="section band work">
    <div class="container">
      <div class="head">
        <h2>What I work in.</h2>
        <p class="lead">I’m genuinely tool-agnostic at the strategy layer. At the build layer, the work is done most fluently in Power BI, Tableau, SQL, and Snowflake &mdash; the tools that cover most of what organizations actually need.</p>
      </div>
      <dl class="defs">
        <div><dt>SQL</dt><dd>The foundation of everything. T-SQL, PostgreSQL, Snowflake SQL &mdash; querying, modeling, transformations.</dd></div>
        <div><dt>Power BI</dt><dd>End-to-end: data model, DAX, report design, publishing, access control, gateway configuration.</dd></div>
        <div><dt>Tableau</dt><dd>Calculated fields, LOD expressions, Server/Cloud publishing, and performance optimization.</dd></div>
        <div><dt>Snowflake</dt><dd>Cloud data warehousing &mdash; schema design, role-based access, query optimization, cost governance.</dd></div>
        <div><dt>Data Modeling</dt><dd>Star schema, dimensional modeling, semantic layer design for BI consumption.</dd></div>
        <div><dt>Governance</dt><dd>Metric dictionaries, data ownership frameworks, documentation standards, lineage.</dd></div>
      </dl>
    </div>
  </section>

  <!-- PHILOSOPHY -->
  <section class="section band band--ink think">
    <div class="container">
      <div class="head">
        <h2>How I think about this work.</h2>
      </div>
      <div class="think__points">
        <div>
          <h3>Strategy before tools.</h3>
          <p>Technology decisions made before the strategic questions are answered tend to create expensive, underused infrastructure. The question “what do you need your data to do?” has to precede “what platform should we use?”</p>
        </div>
        <div>
          <h3>Trust is the product.</h3>
          <p>The real deliverable of analytics work isn’t a dashboard &mdash; it’s a data environment that people trust enough to use when they make decisions. Everything else is in service of that.</p>
        </div>
        <div>
          <h3>Show the method.</h3>
          <p>Every field study here names its sources and says what the data can and can’t support. When a chart is approximate, it says so.</p>
        </div>
        <div>
          <h3>Even-handed analysis.</h3>
          <p>The same standard applies to every study on this site: steelman the counter-argument, be clear about what the data can and can’t say, and don’t let a preferred conclusion drive the analysis.</p>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── The author: text on seven parts, the portrait on four, centred on each other ── */
  .about-hero { padding-block: var(--space-2xl); }
  .about-hero__in { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); column-gap: var(--space-3xl); row-gap: var(--space-xl); align-items: center; }
  .about-hero__text { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-lg); }
  .about-hero h1 { max-width: 18ch; font-size: var(--text-display-s); line-height: 1.02; }
  .about-hero .lead { max-width: 64ch; }
  .about-hero__plate img { aspect-ratio: 4 / 5; object-fit: cover; }
  .about-hero__plate figcaption { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2xs) var(--space-sm); }
  .about-hero__plate figcaption strong { font-weight: 700; color: var(--color-ink); }
  @media (max-width: 60rem) {
    .about-hero { padding-block: var(--space-xl); }
    .about-hero__in { grid-template-columns: minmax(0, 1fr); }
    .about-hero__plate { max-width: 22rem; }
  }

  /* ── The career arc: the prose in columns, the stations as a ruled index ── */
  .arc .cols { padding-bottom: var(--space-2xl); }
  .timeline__when { font-family: var(--font-display); font-weight: 700; font-size: var(--text-title); line-height: 1.2; letter-spacing: var(--tracking-display); color: var(--color-ink); }
  .timeline .index__kind { grid-column: 1 / span 3; }
  .timeline .index__main { grid-column: 4 / span 9; }
  .timeline__org { margin-top: var(--space-2xs); font-size: var(--text-sm); font-weight: 500; color: var(--color-muted); }
  @media (max-width: 60rem) { .timeline .index__kind, .timeline .index__main { grid-column: 1 / -1; order: 0; } }

  /* ── How I think: four points on the ink band, parted by rules ── */
  .think__points { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: var(--rule-double-on-ink); }
  .think__points > div { padding: var(--space-xl) var(--space-lg) 0; border-left: var(--rule-hair) solid var(--color-rule-on-ink); min-width: 0; }
  .think__points > div:first-child { padding-left: 0; border-left: 0; }
  .think__points > div:last-child { padding-right: 0; }
  .think__points h3 { margin-bottom: var(--space-sm); }
  .think__points p { color: var(--color-on-ink-2); }
  @media (max-width: 75rem) {
    .think__points { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--space-xl); }
    .think__points > div:nth-child(odd) { padding-left: 0; border-left: 0; }
  }
  @media (max-width: 40rem) {
    .think__points { grid-template-columns: minmax(0, 1fr); row-gap: 0; }
    .think__points > div, .think__points > div:nth-child(odd) { padding: var(--space-lg) 0; border-left: 0; border-top: var(--rule-hair) solid var(--color-rule-on-ink); }
    .think__points > div:first-child { border-top: 0; }
  }
</style>
