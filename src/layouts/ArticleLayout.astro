---
// ArticleLayout.astro — the ONE layout for articles & field studies.
// Refaced to the product-first design (site-reface): the navy shell header
// (cream wordmark + twine "See it on your estate" CTA, matching Nav.astro),
// byline header (from props), the Honest-Expert closing CTA, and the compact
// article footer. Every article renders through this — which is what keeps the
// insights library visually one piece with the refaced site while its
// SEO-earning body (the <slot/>) and Article JSON-LD stay untouched.
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/article.css";
import Seo from "../components/Seo.astro";
import { nav, site, canonicalUrl, linkHref } from "../data/nav.ts";
import { sections, featured } from "../data/insights.ts";
import Wordmark from "../components/Wordmark.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  kicker: string;
  headingHtml: string;
  dekHtml: string;
  meta: string[];
  author?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
}
const {
  title, description, path, kicker, headingHtml, dekHtml,
  meta = [], author = "Jonathan Doreau", ogTitle, ogDescription, ogImage,
} = Astro.props;
const canonical = canonicalUrl(path);
// Publish date: looked up from insights.ts by slug (one source — articles
// don't restate it). Dates are git-derived; see the Row.published comment.
const slug = path.split("/").filter(Boolean).pop();
const row = sections.flatMap((s) => s.rows).find((r) => r.slug === slug) ?? (featured.slug === slug ? featured : undefined);
const published = row?.published;
const publishedDisplay = published
  ? new Date(published + "T00:00:00").toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
  : undefined;
// JSON-LD headline: the title alone — drop the visual subtitle span and
// decode the entities Astro leaves in the raw prop string.
const headline = headingHtml
  .replace(/<span class="sub">[\s\S]*?<\/span>/g, "")
  .replace(/<[^>]+>/g, "")
  .replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'")
  .trim();
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <Seo title={title} description={description} path={path} ogType="article" ogTitle={ogTitle} ogDescription={ogDescription} ogImage={ogImage} />
    {published && <meta property="article:published_time" content={published} />}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      headline,
      description,
      author: { "@type": "Person", name: author },
      publisher: { "@type": "Person", name: site.author, url: new URL("/about/", site.url).href },
      mainEntityOfPage: canonical,
      url: canonical,
      ...(published ? { datePublished: published } : {}),
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <nav class="reface-nav">
      <div class="nav-in">
        <Wordmark variant="nav" href="/" />
        <div class="site-links">
          {nav.map((i) => (<a href={linkHref(i.href)} class:list={[{ "nav-accent": i.accent }]}>{i.label}</a>))}
        </div>
      </div>
    </nav>

    <main id="main" class="wrap">
      <article>
        <div class="kicker reveal">{kicker}</div>
        <h1 class="reveal" style="animation-delay:.05s" set:html={headingHtml}></h1>
        <p class="dek reveal" style="animation-delay:.1s" set:html={dekHtml}></p>
        <div class="byline reveal" style="animation-delay:.16s">
          <span class="reg">By <strong>{author}</strong></span>
          {publishedDisplay && (<Fragment><span class="dot">&bull;</span><span class="reg">{publishedDisplay}</span></Fragment>)}
          {meta.map((m) => (<Fragment><span class="dot">&bull;</span><span class="reg">{m}</span></Fragment>))}
        </div>
      </article>
      <slot />
    </main>

    <section class="article-cta ae-mark">
      <div class="acta-in">
        <div class="acta-eyebrow">About the author</div>
        <h2>Research and writing by Jonathan Doreau.</h2>
        <p>Jonathan is a data and analytics professional in Nashville with more than fifteen years in reporting, business intelligence and data governance, across finance, healthcare research and real estate. This site collects his field studies and his writing on how organizations measure things.</p>
        <div class="acta-row">
          <a href="/publications/" class="acta-btn">Read the research →</a>
          <a href="/insights/" class="acta-ghost">All writing →</a>
        </div>
      </div>
    </section>

    <footer class="site">
      <div class="fin">
        <Wordmark variant="article-footer" />
        <div class="fmoral">{site.tagline}</div>
        <a href="/insights/" class="fback">&larr; All writing</a>
      </div>
      <div class="flegal">This site uses Google Analytics. <a href="/privacy/">Privacy</a></div>
    </footer>

    <style>
      /* ── Navy reface shell for the article header ─────────────────────────
         Overrides the light nav rules in article.css so the insights library
         wears the SAME product-first navy header as the refaced site (matches
         Nav.astro). Cream wordmark + links, twine hover, twine CTA pill. */
      nav.reface-nav { background:rgba(15,31,56,.94); border-bottom:1px solid rgba(255,255,255,.07); }
      nav.reface-nav .site-links a { color:#B7C0CD; }
      nav.reface-nav .site-links a:hover { color:var(--cream); }
      nav.reface-nav .site-links a.nav-accent { color:var(--twine); }
      nav.reface-nav .site-links a.nav-accent:hover { color:var(--twine-bright); }
      nav.reface-nav .site-cta { background:var(--twine); color:var(--navy)!important; }
      nav.reface-nav .site-cta:hover { background:var(--twine-bright); }

      /* ── The Honest-Expert closing CTA (navy field, twine top-rule, æ mark) ── */
      .article-cta { background:var(--navy); border-top:3px solid var(--twine); padding:66px 32px; text-align:center; position:relative; overflow:hidden; }
      .article-cta.ae-mark::after { content:"æ"; position:absolute; right:-2%; bottom:-34%; font-family:"Abril Fatface",serif; font-size:min(38vw,360px); line-height:1; color:rgba(193,140,93,.05); pointer-events:none; user-select:none; z-index:0; }
      .acta-in { max-width:660px; margin:0 auto; position:relative; z-index:1; }
      .acta-eyebrow { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.22em; color:var(--twine); margin-bottom:16px; }
      .article-cta h2 { font-family:"Newsreader",Georgia,serif; font-weight:600; font-size:clamp(24px,3.2vw,34px); line-height:1.12; color:#fff; margin-bottom:16px; letter-spacing:-.01em; }
      .article-cta p { font-size:16px; color:#A8B4C0; line-height:1.62; font-weight:300; margin-bottom:26px; }
      .acta-row { display:flex; flex-wrap:wrap; gap:14px; justify-content:center; align-items:center; }
      .acta-btn { display:inline-block; background:var(--twine); color:var(--navy); padding:13px 26px; border-radius:4px; font-size:14px; font-weight:700; letter-spacing:.02em; transition:background .2s, transform .2s; }
      .acta-btn:hover { background:var(--twine-bright); transform:translateY(-2px); }
      .acta-ghost { display:inline-block; background:transparent; color:var(--cream); border:1.5px solid rgba(243,239,230,.3); padding:12px 24px; border-radius:4px; font-size:14px; font-weight:600; letter-spacing:.02em; transition:border-color .2s, color .2s; }
      .acta-ghost:hover { border-color:var(--twine); color:var(--twine); }
      .acta-note { font-size:13px; color:#7788A0; font-weight:300; margin:22px 0 0; }
    </style>
    <!-- The .reveal entrance animation runs from base.css at load (with its
         prefers-reduced-motion fallback). The old IntersectionObserver here
         re-applied the animation inline, which overrode that fallback for
         reduced-motion users — removed deliberately; do not re-add without a
         matchMedia gate. -->
  </body>
</html>
