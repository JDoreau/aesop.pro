---
// ArticleLayout.astro — the ONE layout for articles & field studies: the bar
// masthead, the article head (title, the subtitle as a second line, the dek, a
// dateline row), the body on the prose grid, the æ end mark, the author note
// and the site footer. Every article renders through this, which keeps the
// library one piece with the site while its body (the <slot/>) and its Article
// JSON-LD stay untouched.
import "../styles/site.css";
import "../styles/article.css";
import Seo from "../components/Seo.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site, canonicalUrl } from "../data/nav.ts";
import { sections, featured } from "../data/insights.ts";

interface Props {
  title: string;
  description: string;
  path: string;
  kicker: string;
  headingHtml: string;
  dekHtml: string;
  meta: string[];
  author?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
}
const {
  title, description, path, kicker, headingHtml, dekHtml,
  meta = [], author = "Jonathan Doreau", ogTitle, ogDescription, ogImage,
} = Astro.props;
const canonical = canonicalUrl(path);
// Publish date: looked up from insights.ts by slug (one source — articles
// don't restate it). Dates are git-derived; see the Row.published comment.
const slug = path.split("/").filter(Boolean).pop();
const row = sections.flatMap((s) => s.rows).find((r) => r.slug === slug) ?? (featured.slug === slug ? featured : undefined);
const published = row?.published;
const publishedDisplay = published
  ? new Date(published + "T00:00:00").toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
  : undefined;
// JSON-LD headline: the title alone — drop the visual subtitle span and
// decode the entities Astro leaves in the raw prop string.
const headline = headingHtml
  .replace(/<span class="sub">[\s\S]*?<\/span>/g, "")
  .replace(/<[^>]+>/g, "")
  .replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&#39;/g, "'")
  .trim();
// The dateline: the kicker and the meta strings set as separate facts in one
// ruled row under the dek. A "·" in the data is a separator, so it becomes a
// column break; a fact said twice (the pillar in both strings) is said once.
const facts: string[] = [];
for (const part of [kicker, ...meta].flatMap((s) => s.split("·"))) {
  const fact = part.trim();
  if (fact && !facts.some((f) => f.toLowerCase() === fact.toLowerCase())) facts.push(fact);
}
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <Seo title={title} description={description} path={path} ogType="article" ogTitle={ogTitle} ogDescription={ogDescription} ogImage={ogImage} />
    {published && <meta property="article:published_time" content={published} />}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      headline,
      description,
      author: { "@type": "Person", name: author },
      publisher: { "@type": "Person", name: site.author, url: new URL("/about/", site.url).href },
      mainEntityOfPage: canonical,
      url: canonical,
      ...(published ? { datePublished: published } : {}),
    })} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />

    <main id="main">
      <header class="article__head">
        <div class="container">
          <h1 id="article-title" set:html={headingHtml}></h1>
          <p class="article__dek" set:html={dekHtml}></p>
          <ul class="meta article__meta">
            <li>By <strong>{author}</strong></li>
            {publishedDisplay && <li><time datetime={published}>{publishedDisplay}</time></li>}
            {facts.map((f) => (<li>{f}</li>))}
          </ul>
        </div>
      </header>
      <div class="article__main" role="article" aria-labelledby="article-title">
        <div class="container">
          <slot />
          <p class="article__end" aria-hidden="true"><span class="endmark">æ</span></p>
        </div>
      </div>

      <aside class="author-note band" aria-label="About the author">
        <div class="container author-note__in">
          <h2>Research and writing by Jonathan Doreau.</h2>
          <div class="author-note__body">
            <p>Jonathan is a data and analytics professional in Nashville with more than fifteen years in reporting, business intelligence and data governance, across finance, healthcare research and real estate. This site collects his field studies and his writing on how organizations measure things.</p>
            <p class="actions">
              <a href="/publications/" class="more">Read the research</a>
              <a href="/insights/" class="more">All writing</a>
            </p>
          </div>
        </div>
      </aside>
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  /* The Floor: no sideways scroll at any width (base.css says it too; the layout states it where the document is declared). */
  html, body { overflow-x: clip; }
</style>
