---
// SpineCard.astro — one part of the product spine (The Portal / The Agent / The Scribe /…).
// -----------------------------------------------------------------------------
// A navy card carrying a step numeral, the plain function name with its Greek
// product-line name beneath (NAMING-CANON: function leads, Greek in italics),
// a description, and an honest status chip. Assemble 3+ inside a .spine grid on
// a navy field. .hl gives the flagship card its twine top-rule.
//
// PROPS:
//   step     — the "01"/"02" numeral (string).
//   name     — the plain function name (e.g. "The Portal"). Function LEADS.
//   greek    — the Greek product-line name (e.g. "Aesop Stoa"). Shown italic.
//   status   — "dep" | "prev" | "road" — the honest maturity of THIS part.
//   statusLabel — the chip text (e.g. "Deployed — log in today").
//   highlight — true → twine top-rule (mark the deployed flagship).
//
// SLOT: default → the description paragraph (.p-desc).
//
// STATUS DISCIPLINE: the chip must match the true maturity ladder
// (BRAND-VOICE §5). Never chip something "dep" that is only in preview.
interface Props {
  step: string;
  name: string;
  greek: string;
  status: "dep" | "prev" | "road";
  statusLabel: string;
  highlight?: boolean;
}
const { step, name, greek, status, statusLabel, highlight = false } = Astro.props;
---
<div class:list={["spine-card", { hl: highlight }]}>
  <div class="p-step">{step}</div>
  <div class="p-name">{name}<span class="greek">{greek}</span></div>
  <div class="p-desc"><slot /></div>
  <span class:list={["chip", status]}><span class="cd"></span>{statusLabel}</span>
</div>
