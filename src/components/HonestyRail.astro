---
// HonestyRail.astro — THE signature move of the reface.
// -----------------------------------------------------------------------------
// The deployed-today / in-preview / on-the-roadmap rail that binds every
// capability claim to its true maturity (BRAND-VOICE §5). No other governance
// vendor tells you what ISN'T finished; in a trust company, that rail IS the
// pitch. Sits inside a navy field (the product section or a platform page).
//
// PROPS:
//   heading   — the rail title (default "Where the product actually stands").
//   sub       — the plain-English reason we say this (one warm sentence).
//   deployed  — string: what is DEPLOYED TODAY. Present tense, real.
//   preview   — string: what is IN PREVIEW. Future tense, honestly staged.
//   roadmap   — string: what is ON THE ROADMAP. Optional; omit to show 2 rungs.
//
// HONESTY CONTRACT (do not violate — it is the whole point):
//   • "Deployed" earns present tense + a screenshot-grade claim.
//   • "In preview" earns future tense + the label.
//   • "On the roadmap" earns the honest not-finished framing (never Tableau
//     auto-gen as shipped; Mnemosyne never appears client-facing).
// The TRUE statuses to draw from live in BRAND-VOICE.md §5 / SITE-DIRECTION §0.
interface Props {
  heading?: string;
  sub?: string;
  deployed: string;
  preview: string;
  roadmap?: string;
}
const {
  heading = "Where the platform actually stands",
  sub = "We say this plainly because it's the whole point: a company building the trust layer for the AI era should be the first to tell you what its own software can and can't do yet. Here is the truth, in order.",
  deployed,
  preview,
  roadmap,
} = Astro.props;
---
<div class="honesty-rail">
  <div class="rail-h">{heading}</div>
  <div class="rail-sub">{sub}</div>
  <div class="rail-rows" style={!roadmap ? "grid-template-columns:repeat(2,1fr)" : undefined}>
    <div class="rr dep">
      <span class="rlab"><span class="cd"></span>Deployed today</span>
      <span class="rtxt" set:html={deployed} />
    </div>
    <div class="rr prev">
      <span class="rlab"><span class="cd"></span>In preview</span>
      <span class="rtxt" set:html={preview} />
    </div>
    {roadmap && (
      <div class="rr road">
        <span class="rlab"><span class="cd"></span>On the roadmap</span>
        <span class="rtxt" set:html={roadmap} />
      </div>
    )}
  </div>
</div>
