---
// Footer.astro — the ONE footer, on every page: a letter close. The site's
// moral as the sign-off, the author's name and place beneath it, the real
// links beside it, then the colophon line (lockup, tagline, the legal line).
import { site } from "../data/nav.ts";
import Wordmark from "./Wordmark.astro";
const year = new Date().getFullYear(); // evaluated at build time; correct as long as the site rebuilds
---
<footer class="foot">
  <div class="container">
    <div class="foot__close">
      <div class="foot__sign">
        <p class="foot__moral">Every dataset has a moral.</p>
        <p class="foot__name">{site.author}<br />{site.location}</p>
      </div>
      <nav class="foot__links" aria-label="Footer">
        <div>
          <p class="foot__h">Research</p>
          <a href="/publications/">Field studies</a>
          <a href="/insights/">Writing</a>
        </div>
        <div>
          <p class="foot__h">Tools</p>
          <a href="/resources/health-check/">Reporting Trust Health Check</a>
          <a href="/resources/dashboard-audit/">Dashboard Audit</a>
        </div>
        <div>
          <p class="foot__h">About</p>
          <a href="/about/">About Jonathan</a>
          <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href="/privacy/">Privacy</a>
        </div>
      </nav>
    </div>
    <div class="foot__colophon">
      <Wordmark variant="footer" />
      <p class="foot__tag">{site.tagline}</p>
      <p class="foot__legal">&copy; {year} {site.author}. All rights reserved. <span class="ga-note">This site uses Google Analytics to understand how it&rsquo;s used. <a href="/privacy/">Privacy</a></span></p>
    </div>
  </div>
</footer>

<style>
  .foot { margin-top: var(--section-gap-s); padding-bottom: var(--space-2xl); }
  .foot__close { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap-columns); row-gap: var(--space-xl); padding-block: var(--space-2xl); border-top: var(--rule-double); }
  .foot__sign { grid-column: 1 / span 6; }
  .foot__moral { max-width: 14ch; font-family: var(--font-display); font-weight: 700; font-size: var(--text-display-s); line-height: 1.02; letter-spacing: var(--tracking-display); text-wrap: balance; }
  .foot__name { margin-top: var(--space-lg); font-size: var(--text-md); font-weight: 500; line-height: 1.4; color: var(--color-ink-2); }
  .foot__links { grid-column: 7 / -1; display: flex; flex-wrap: wrap; justify-content: space-between; align-content: start; gap: var(--space-lg) var(--space-xl); }
  .foot__links > div { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-2xs); white-space: nowrap; }
  .foot__h { margin-bottom: var(--space-2xs); font-family: var(--font-display); font-weight: 700; font-size: var(--text-md); line-height: 1.2; }
  .foot__links a { display: inline-flex; align-items: center; min-height: 32px; font-size: var(--text-md); line-height: 1.3; color: var(--color-ink-2); text-decoration: none; }
  .foot__links a:hover { color: var(--color-accent); text-decoration: underline; text-decoration-thickness: 2px; }
  .foot__links a:active { color: var(--color-ink); }
  .foot__colophon { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-md) var(--space-xl); padding-top: var(--space-lg); border-top: var(--rule-hair) solid var(--color-rule); }
  .foot__tag { font-size: var(--text-sm); font-weight: 500; color: var(--color-ink-2); max-width: none; }
  .foot__legal { font-size: var(--text-sm); line-height: 1.5; color: var(--color-muted); max-width: 62ch; }
  .foot__legal a { color: var(--color-accent); text-decoration: underline; }
  .foot__legal a:hover { text-decoration-thickness: 2px; }
  @media (max-width: 60rem) {
    .foot__sign, .foot__links { grid-column: 1 / -1; }
  }
  @media (max-width: 60rem) { .foot__links { justify-content: flex-start; gap: var(--space-lg) var(--space-2xl); } }
  @media (max-width: 40rem) { .foot__colophon { flex-direction: column; align-items: flex-start; } }
</style>
