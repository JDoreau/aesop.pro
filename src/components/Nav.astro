---
// Nav.astro — the ONE masthead, rendered from nav.ts so it can never drift.
// Two shapes: the front page carries the nameplate (a large centred lockup, the
// sections in a folio row beneath it); every other page carries an edge-aligned
// bar. Four sections fit one row at every width, so there is no menu button and
// no script.
import { nav, site, linkHref } from "../data/nav.ts";
import Wordmark from "./Wordmark.astro";

interface Props { front?: boolean; }
const { front = false } = Astro.props;
const path = (Astro.url.pathname.replace(/\/+$/, "") || "/");
const isCurrent = (href: string) => href === path || (href !== "/" && path.startsWith(href + "/"));
---
<header class:list={["mast", { "mast--front": front }]}>
  <div class="container">
    <div class="mast__in">
      <Wordmark variant={front ? "masthead" : "bar"} href="/" />
      <div class="mast__folio">
        {front && <p class="mast__place">{site.location}</p>}
        <nav class="mast__nav" aria-label="Sections">
          {nav.map((i) => (
            <a href={linkHref(i.href)} aria-current={isCurrent(i.href) ? "page" : undefined}>{i.label}</a>
          ))}
        </nav>
        {front && <p class="mast__by">Research &amp; writing, {site.author}</p>}
      </div>
    </div>
  </div>
</header>

<style>
  /* ── The bar (inner pages): lockup at one edge, sections at the other, the double rule beneath ── */
  .mast { background: var(--color-paper); }
  .mast__in { display: flex; align-items: center; justify-content: space-between; gap: var(--space-lg); min-height: 72px; border-bottom: var(--rule-double); }
  .mast__nav { display: flex; align-items: stretch; gap: var(--space-lg); }
  .mast__nav a { display: inline-flex; align-items: center; min-height: 44px; font-size: var(--text-md); font-weight: 500; line-height: 1; color: var(--color-ink-2); text-decoration: none; white-space: nowrap; }
  .mast__nav a:hover { color: var(--color-ink); text-decoration: underline; text-decoration-thickness: 2px; text-decoration-color: var(--color-accent); text-underline-offset: 0.4em; }
  .mast__nav a[aria-current="page"] { color: var(--color-ink); text-decoration: underline; text-decoration-thickness: 2px; text-decoration-color: var(--color-ink); text-underline-offset: 0.4em; }
  .mast__nav a:active { color: var(--color-accent); }
  .mast__place, .mast__by { flex: 1 1 0; font-size: var(--text-sm); font-weight: 500; line-height: 1.3; color: var(--color-muted); max-width: none; }
  .mast__by { text-align: right; }

  @media (max-width: 40rem) {
    .mast__in { flex-direction: column; align-items: stretch; gap: var(--space-sm); padding-top: var(--space-md); }
    .mast__folio { border-top: var(--rule-hair) solid var(--color-rule); }
    .mast__nav { justify-content: space-between; gap: var(--space-xs); }
  }

  /* ── The nameplate (front page): the lockup large and centred, the folio row under a hairline ── */
  .mast--front .mast__in { flex-direction: column; align-items: stretch; gap: var(--space-md); min-height: 0; padding-top: var(--space-lg); }
  .mast--front :global(.wm) { align-self: center; }
  .mast--front .mast__folio { display: flex; align-items: center; justify-content: space-between; gap: var(--space-lg); min-height: 48px; border-top: var(--rule-hair) solid var(--color-rule); }
  .mast--front .mast__nav { gap: var(--space-xl); }

  @media (max-width: 60rem) {
    /* the sections take the first row; the place and the byline share the row beneath */
    .mast--front .mast__in { padding-top: var(--space-md); }
    .mast--front .mast__folio { flex-wrap: wrap; gap: 0 var(--space-md); padding-bottom: var(--space-xs); }
    .mast--front .mast__nav { order: -1; flex: 1 0 100%; justify-content: space-between; gap: var(--space-xs); border-bottom: var(--rule-hair) solid var(--color-rule); margin-bottom: var(--space-xs); }
    .mast--front .mast__place, .mast--front .mast__by { flex: 0 1 auto; }
  }
</style>
