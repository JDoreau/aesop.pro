---
// Reveal.astro — the ONE rise-on-scroll observer for the reface.
// -----------------------------------------------------------------------------
// Drop this ONCE near the end of any page that uses .reveal-able elements on
// scroll. It hides the targeted selectors, then reveals each on intersection
// with a staggered delay. Reduced-motion is guarded (elements stay visible,
// no observer). The rise keyframe itself lives in base.css.
//
// PROPS:
//   selector — CSS selector(s) to observe (default covers the shared section
//              components). Pass your own to scope to a page's elements.
//
// USAGE (in a page): <Reveal selector=".spine-card,.proof-card,.safe-item" />
// The hero's own intro copy animates via inline animation-delay (see Hero); this
// observer is for below-the-fold content that should rise as it scrolls in.
interface Props { selector?: string; }
const { selector = ".spine-card,.safe-item,.proof-card,.pain-item,.rr,.flow-step,.stat-band .stat-in>div" } = Astro.props;
---
<script is:inline define:vars={{ selector }}>
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.style.animation = "rise .7s cubic-bezier(.2,.7,.2,1) forwards";
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll(selector).forEach((el, i) => {
      el.style.opacity = "0";
      el.style.animationDelay = ((i % 6) * 0.05) + "s";
      io.observe(el);
    });
  }
</script>
