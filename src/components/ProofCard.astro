---
// ProofCard.astro — one result/proof card (the anonymized engagement outcomes).
// -----------------------------------------------------------------------------
// A light card with a big twine numeral, an optional unit, a plain label, and
// a sector + deep-link footer. Assemble inside a .proof-grid. Renders as an
// <a> when `href` is given (deep-links to the /work case anchors) else a <div>.
//
// PROPS:
//   n       — the headline number (string, e.g. "31" or "~4").
//   unit    — optional small unit appended to the number (e.g. " hrs").
//   label   — the plain result sentence.
//   sector  — the sector eyebrow (e.g. "Finance & Banking").
//   href    — optional deep link (e.g. "/work/#finance-banking"). Pass the
//             already-slashed form or route through linkHref() at the call site.
//   linkText — the CTA text (default "See the case →").
//
// HONESTY: numbers here are representative/anonymized engagement signals — the
// page using this component states that caveat (see .proof-caveat in sections.css).
interface Props {
  n: string;
  unit?: string;
  label: string;
  sector: string;
  href?: string;
  linkText?: string;
}
const { n, unit, label, sector, href, linkText = "See the case →" } = Astro.props;
const Tag = href ? "a" : "div";
---
<Tag class="proof-card" href={href}>
  <div class="res-n">{n}{unit && <span class="u">{unit}</span>}</div>
  <div class="res-l">{label}</div>
  <div class="res-meta">
    <span class="res-sector">{sector}</span>
    {href && <span class="res-link">{linkText}</span>}
  </div>
</Tag>
