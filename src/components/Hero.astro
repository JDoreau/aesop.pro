---
// Hero.astro — the navy hero field (the reface's front-door pattern).
// -----------------------------------------------------------------------------
// A navy band with the æ watermark, an eyebrow, an H1 (with optional twine
// accent word via <span class="em">), a warm sub, a CTA row, and an optional
// meta note line. Built from sections.css classes.
//
// SLOTS:
//   default   — the H1 markup (pass your own <h1> so per-page phrasing/accents
//               are explicit and the twine word lands where you want it).
//   sub       — the warm sub-paragraph (rendered as .hero-sub).
//   cta       — the .btn-row (pass the buttons you want; product-led first).
//   note      — optional meta line (rendered as .hero-note).
//
// PROPS:
//   eyebrow   — the category eyebrow text (the "software company" signal).
//   watermark — show the æ flourish (default true).
//
// The intro elements carry inline animation so the hero animates on load
// without needing the scroll observer (which is for below-the-fold content).
interface Props { eyebrow?: string; watermark?: boolean; }
const { eyebrow, watermark = true } = Astro.props;
---
<section class:list={["hero", { "ae-host ae-mark": watermark }]} style="--ae-size:min(46vw,560px); --ae-right:-3%; --ae-top:-16%; --ae-opacity:.065;">
  <div class="hero-in">
    {eyebrow && <div class="eyebrow reveal" style="animation:rise .6s ease forwards">{eyebrow}</div>}
    <div class="reveal" style="animation:rise .7s cubic-bezier(.2,.7,.2,1) .08s forwards"><slot /></div>
    <p class="hero-sub reveal" style="animation:rise .7s cubic-bezier(.2,.7,.2,1) .16s forwards"><slot name="sub" /></p>
    <div class="btn-row reveal" style="animation:rise .7s cubic-bezier(.2,.7,.2,1) .24s forwards"><slot name="cta" /></div>
    <slot name="note" />
  </div>
</section>
